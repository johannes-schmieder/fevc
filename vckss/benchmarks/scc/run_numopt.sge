#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 4
#$ -l h_rt=01:45:00
#$ -l mem_per_core=16G
#$ -N kss_numopt

set -euo pipefail
: "${KSS_RUN_DIR:?KSS_RUN_DIR is required}"
: "${KSS_SOURCE_DIR:?KSS_SOURCE_DIR is required}"
: "${KSS_SOURCE_COMMIT:?KSS_SOURCE_COMMIT is required}"
: "${KSS_RUN_ID:?KSS_RUN_ID is required}"
: "${KSS_ROUTE:?KSS_ROUTE is required}"
: "${KSS_SCENARIO:?KSS_SCENARIO is required}"
: "${KSS_WORKERS:?KSS_WORKERS is required}"
: "${KSS_FIRMS:?KSS_FIRMS is required}"
: "${KSS_PROBES:?KSS_PROBES is required}"
: "${KSS_SEED:?KSS_SEED is required}"
: "${KSS_MEMORY_GIB:?KSS_MEMORY_GIB is required}"
: "${KSS_PROJECTED_SECONDS:?KSS_PROJECTED_SECONDS is required}"
: "${KSS_PROJECTION_BASIS:?KSS_PROJECTION_BASIS is required}"

test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$KSS_SOURCE_COMMIT"
case "$KSS_ROUTE" in b1|cmg) ;; *) exit 198 ;; esac
case "$KSS_SCENARIO" in easy|moderate|weak) ;; *) exit 198 ;; esac
awk -v value="$KSS_PROJECTED_SECONDS" 'BEGIN { exit !(value > 0 && value <= 5400) }'

module purge
module load stata-mp/19
export OMP_NUM_THREADS="${NSLOTS:-4}"

job_dir="$KSS_RUN_DIR/numopt/$KSS_SCENARIO/$KSS_ROUTE"
mkdir -p "$job_dir"
cd "$KSS_SOURCE_DIR"

/usr/bin/time -v -o "$job_dir/resources.txt" \
  /usr/bin/timeout --signal=TERM 5400 \
  stata-mp -q do vckss/benchmarks/estimator_cmg_benchmark.do \
  "$KSS_RUN_ID" "$KSS_ROUTE" "$KSS_SCENARIO" "$KSS_WORKERS" \
  "$KSS_FIRMS" "$KSS_PROBES" "$KSS_SEED" "$KSS_MEMORY_GIB" \
  "$KSS_PROJECTED_SECONDS" "$KSS_PROJECTION_BASIS" "$job_dir" \
  "$KSS_SOURCE_COMMIT" \
  > "$job_dir/application.txt" 2>&1

test -s "$job_dir/numopt_${KSS_SCENARIO}_${KSS_ROUTE}.csv"
test -s "$job_dir/numopt_${KSS_SCENARIO}_${KSS_ROUTE}.stata.pass"
grep -F "VCKSS NUMOPT BENCHMARK PASS: $KSS_ROUTE $KSS_SCENARIO" \
  "$job_dir/application.txt"
printf '%s\n' \
  "VCKSS_NUMOPT_WRAPPER_PASS $KSS_ROUTE $KSS_SCENARIO $KSS_SOURCE_COMMIT" \
  > "$job_dir/wrapper.pass"
printf '%s\n' "VCKSS SCC NUMOPT PASS: $KSS_ROUTE $KSS_SCENARIO"
