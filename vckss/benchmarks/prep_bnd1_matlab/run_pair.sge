#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N pbm_pair
#$ -pe omp 4
#$ -l h_rt=02:10:00
#$ -l mem_per_core=14G

# Deliberately non-submitting.  A caller supplies one immutable scheduler task and
# resources; post-job acceptance is performed by validate_scc_job.py.
set -euo pipefail
for name in PBM_ROOT PBM_RUN_ID PBM_SOURCE_DIR PBM_SOURCE_COMMIT \
  PBM_BUNDLE_SHA256 PBM_BUNDLE_MANIFEST PBM_TASK_FILE PBM_TASK_SHA256 \
  PBM_MATLAB_ROOT TMPDIR JOB_ID HOSTNAME NSLOTS; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done
[[ "$PBM_ROOT" == /projectnb/welfgr/vckss/prep-bnd1-matlab ]]
[[ "$PBM_RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$PBM_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$PBM_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$PBM_TASK_SHA256" =~ ^[0-9a-f]{64}$ ]]
test "$PBM_SOURCE_DIR" = \
  "/projectnb/welfgr/vckss/bundles/$PBM_BUNDLE_SHA256/source"
test "$PBM_BUNDLE_MANIFEST" = \
  "/projectnb/welfgr/vckss/bundles/$PBM_BUNDLE_SHA256.files.sha256"
test -d "$PBM_SOURCE_DIR" && test -f "$PBM_BUNDLE_MANIFEST"
test -f "$PBM_TASK_FILE" && test ! -L "$PBM_TASK_FILE"
test "$(sha256sum "$PBM_TASK_FILE" | awk '{print $1}')" = "$PBM_TASK_SHA256"
test "$(tr -d '[:space:]' < "$PBM_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$PBM_SOURCE_COMMIT"
test "${NSLOTS}" = 4
case "$PBM_MATLAB_ROOT" in
  /projectnb/welfgr/separations/*/LeaveOutTwoWay) ;;
  *) exit 198 ;;
esac

IFS=$'\t' read -r task_schema task_commit task_bundle experiment firms \
  workers degree rows probes seed order requested_slots stata_processors \
  matlab_workers mem_per_core hard_wall sample_contract target_contract \
  comparison_contract < <(tail -n 1 "$PBM_TASK_FILE")
test "$task_schema" = PREP-BND-1-MATLAB-TASK-V1
test "$task_commit" = "$PBM_SOURCE_COMMIT"
test "$task_bundle" = "$PBM_BUNDLE_SHA256"
[[ "$experiment" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$firms" =~ ^(64|256|1024)$ ]]
test "$workers" = "$(( 40*firms ))"
test "$degree" = 3 && test "$rows" = "$(( 3*workers ))"
[[ "$probes" =~ ^(20|200)$ ]] && [[ "$seed" =~ ^[0-9]+$ ]]
[[ "$order" =~ ^(stata_matlab|matlab_stata)$ ]]
test "$requested_slots" = 4 && test "$stata_processors" = 4
test "$matlab_workers" = 4 && test "$mem_per_core" = 14
test "$hard_wall" = 7200
test "$sample_contract" = same_literal_rows_v1
test "$target_contract" = uniform_stored_rows_v1
test "$comparison_contract" = descriptive_jla_own_pcg_gate_v1

run_dir="$PBM_ROOT/runs/$PBM_RUN_ID"
output_dir="$run_dir/$experiment"
test -d "$run_dir" && test ! -e "$output_dir"
mkdir -p "$output_dir"
cp "$PBM_TASK_FILE" "$output_dir/task.tsv"
printf '%s\n' "$PBM_TASK_SHA256" > "$output_dir/task.sha256"
(cd "$PBM_SOURCE_DIR" && sha256sum -c "$PBM_BUNDLE_MANIFEST") \
  > "$output_dir/source_manifest.check"

scratch="$TMPDIR/prep-bnd1-matlab-$JOB_ID"
case "$scratch" in "$TMPDIR"/*) ;; *) exit 198 ;; esac
test ! -e "$scratch"
mkdir -p "$scratch/input" "$scratch/mex" "$scratch/details" \
  "$scratch/parallel" "$scratch/stata"
chmod 700 "$scratch" "$scratch/input" "$scratch/mex" \
  "$scratch/details" "$scratch/parallel" "$scratch/stata"

wrapper_complete=0
failure_stage=initialization
failure() {
  rc=$?
  if (( wrapper_complete == 0 )); then
    printf 'PREP_BND1_MATLAB_WRAPPER_FAILURE %s stage=%s rc=%s\n' \
      "$experiment" "$failure_stage" "$rc" > "$output_dir/wrapper.fail"
  fi
  exit "$rc"
}
trap failure EXIT

failure_stage=input_generation
module purge
module load stata-mp/19
export STATATMP="$scratch/stata"
stata-mp -q do \
  "$PBM_SOURCE_DIR/vckss/benchmarks/prep_bnd1_matlab/generate_input.do" \
  "$scratch/input/input.csv" "$output_dir/input_receipt.csv" "$firms" \
  > "$output_dir/input_generation.application.txt" 2>&1
grep -F "PREP_BND1_MATLAB_INPUT_PASS F$firms rows=$rows" \
  "$output_dir/input_generation.application.txt"
input_sha=$(sha256sum "$scratch/input/input.csv" | awk '{print $1}')
[[ "$input_sha" =~ ^[0-9a-f]{64}$ ]]
printf '%s\n' "$input_sha" > "$output_dir/input.sha256"

run_stata() {
  failure_stage=stata_application
  module purge
  module load stata-mp/19
  export OMP_NUM_THREADS=4
  export STATATMP="$scratch/stata"
  /usr/bin/time -v -o "$output_dir/stata.resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=60 "$hard_wall" \
    stata-mp -q do \
      "$PBM_SOURCE_DIR/vckss/benchmarks/prep_bnd1_matlab/stata_run.do" \
      "$PBM_SOURCE_DIR" "$scratch/input/input.csv" \
      "$output_dir/stata.csv" "$PBM_SOURCE_COMMIT" "$PBM_TASK_SHA256" \
      "$input_sha" "$firms" "$probes" "$seed" \
      > "$output_dir/stata.application.txt" 2>&1
  # Stata may wrap the 64-character task SHA in its text log.  The task file
  # itself was already hash-verified above; use the unwrapped source prefix as
  # the application marker and bind the task again in stata.csv validation.
  grep -F "PREP_BND1_MATLAB_STATA_PASS $PBM_SOURCE_COMMIT" \
    "$output_dir/stata.application.txt"
  test -s "$output_dir/stata.csv"
}

run_matlab() {
  failure_stage=matlab_source_identity
  module purge
  module load python3/3.12.4
  module load matlab/2025b
  python_bin=$(command -v python3)
  contract="$PBM_SOURCE_DIR/vckss/benchmarks/matlab_scale/source_contract.json"
  contract_sha=$(sha256sum "$contract" | awk '{print $1}')
  "$python_bin" \
    "$PBM_SOURCE_DIR/vckss/benchmarks/scc/verify_numopt2_matlab_source.py" \
    --matlab-root "$PBM_MATLAB_ROOT" --contract "$contract" \
    --contract-sha256 "$contract_sha" \
    --output "$output_dir/matlab_source_identity.json"
  export PBM_OUTPUT_DIR="$output_dir"
  export PBM_SCRATCH_DIR="$scratch"
  export PBM_INPUT_CSV="$scratch/input/input.csv"
  export PBM_INPUT_SHA256="$input_sha"
  export PBM_MATLAB_ROOT
  export PBM_TASK_SHA256
  export PBM_SOURCE_IDENTITY="$output_dir/matlab_source_identity.json"
  export PBM_PROCESS_IDENTITY="$output_dir/matlab_process_identity.json"
  export PBM_EXPERIMENT_ID="$experiment"
  export PBM_SOURCE_COMMIT
  export PBM_BUNDLE_SHA256
  export PBM_ROWS="$rows" PBM_WORKERS="$workers" PBM_FIRMS="$firms"
  export PBM_PROBES="$probes" PBM_SEED="$seed"
  export MATLAB_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
  export OPENBLAS_NUM_THREADS=1
  driver_dir="$PBM_SOURCE_DIR/vckss/benchmarks/prep_bnd1_matlab"
  monitor="$PBM_SOURCE_DIR/vckss/benchmarks/matlab_scale/monitor_process_tree.py"
  failure_stage=matlab_application
  set +e
  /usr/bin/time -v -o "$output_dir/matlab.resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=60 "$hard_wall" \
    matlab -batch "addpath('$driver_dir'); prep_bnd1_matlab_run" \
    > "$output_dir/matlab.application.txt" 2>&1 &
  matlab_pid=$!
  "$python_bin" "$monitor" --root-pid "$matlab_pid" \
    --interval-seconds 0.25 --expected-pool-workers 4 \
    --process-identity "$PBM_PROCESS_IDENTITY" \
    --output "$output_dir/matlab_process_tree_rss.json" \
    > "$output_dir/matlab_process_tree_rss.monitor.txt" 2>&1
  monitor_status=$?
  wait "$matlab_pid"
  matlab_status=$?
  set -e
  test "$matlab_status" = 0 && test "$monitor_status" = 0
  grep -F "PREP-BND-1 MATLAB PASS: $experiment" \
    "$output_dir/matlab.application.txt"
  test -s "$output_dir/matlab_aggregate.json"
  test -s "$output_dir/matlab.pass"
}

if test "$order" = stata_matlab; then
  run_stata
  run_matlab
else
  run_matlab
  run_stata
fi

failure_stage=receipt
{
  printf 'key\tvalue\n'
  printf 'schema\tPREP-BND-1-MATLAB-NODE-V1\n'
  printf 'experiment_id\t%s\n' "$experiment"
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$PBM_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$PBM_BUNDLE_SHA256"
  printf 'task_sha256\t%s\n' "$PBM_TASK_SHA256"
  printf 'input_sha256\t%s\n' "$input_sha"
  printf 'order\t%s\n' "$order"
  printf 'requested_slots\t4\n'
  printf 'actual_slots\t%s\n' "$NSLOTS"
  printf 'stata_processors\t4\n'
  printf 'matlab_pool_workers\t4\n'
  printf 'mem_per_core_gib\t14\n'
} > "$output_dir/node_receipt.tsv"
printf 'PREP_BND1_MATLAB_PAIR_PASS %s %s\n' "$experiment" \
  "$PBM_TASK_SHA256" > "$output_dir/pair.pass"
wrapper_complete=1
failure_stage=complete
trap - EXIT
printf 'PREP-BND-1 MATLAB SCC PAIR PASS: %s\n' "$experiment"
