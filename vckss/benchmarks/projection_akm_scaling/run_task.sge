#!/bin/bash -l
#$ -clear
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -N vpa_pair
set -euo pipefail
for name in VPA_RUN_DIR VPA_STAGE VPA_MANIFEST NSLOTS SGE_TASK_ID; do
  test -n "${!name:-}" || { printf 'missing %s\n' "$name" >&2; exit 198; }
done
test "$NSLOTS" = 16
case "$VPA_STAGE" in
  feasibility-480000|feasibility-1920000|feasibility-7680000|topup-480000|topup-1920000|topup-7680000) ;;
  *) exit 198 ;;
esac
test "$VPA_MANIFEST" = "$VPA_RUN_DIR/manifests/$VPA_STAGE.tsv"
harness=$VPA_RUN_DIR/source/vckss/benchmarks/projection_akm_scaling
output=$VPA_RUN_DIR/tasks/$VPA_STAGE/task-$SGE_TASK_ID
"$harness/run_pair.sh" "$VPA_RUN_DIR" "$VPA_MANIFEST" "$SGE_TASK_ID" "$output" 0 0
module purge
module load python3/3.12.4
python3 "$harness/validate.py" "$output" "$VPA_MANIFEST" "$SGE_TASK_ID" \
  "$output/validation.json"
printf 'VCKSS PROJECTION AKM TASK CAPTURED %s %s\n' "$VPA_STAGE" "$SGE_TASK_ID" \
  > "$output/task.captured"
