* text=auto eol=lf
*.tex text diff=tex
*.bib text
*.md text
*.py text
*.csv text
*.yaml text
*.yml text
*.toml text
*.json text
*.pdf binary
*.png binary
*.zip binary
*.tar binary
*.gz binary

# Historical review packets preserve byte-exact embedded CSV payloads.
reviews/gpt-pro/requests/**/FILES/**/*.csv -text whitespace=cr-at-eol

# Current external-review metadata preserves the exact bytes uploaded to the
# reviewer, including deliberate terminal blank lines.
qualification/gpt-pro/requests/**/MANIFEST.sha256 whitespace=-blank-at-eol,-blank-at-eof
qualification/gpt-pro/requests/**/PACKET.sha256 whitespace=-blank-at-eol,-blank-at-eof
qualification/gpt-pro/requests/**/SOURCE_MAP.md whitespace=-blank-at-eol,-blank-at-eof

# Qualification TSV records preserve an empty final field as a trailing tab.
fevc/qualification/rename_equivalence/*.raw.tsv whitespace=-blank-at-eol

# Stata's transcript format uses prompt continuation and blank lines with
# trailing spaces. These qualification logs are retained byte-for-byte because
# their SHA-256 digests are bound by the adjacent summaries.
fevc/qualification/prep_rhs1/local/*.log whitespace=-blank-at-eol
fevc/qualification/prep_rhs1/local_candidate_first/*.log whitespace=-blank-at-eol

# FE-BUF-1 keeps raw Stata transcripts and fixed-width SGE accounting output.
# Their trailing spaces are source evidence rather than authored whitespace.
fevc/qualification/fe_buf1/**/*.log whitespace=-blank-at-eol
fevc/qualification/fe_buf1/**/qacct.txt whitespace=-blank-at-eol
fevc/qualification/fe_buf1/**/*.qacct.txt whitespace=-blank-at-eol

# The inference comparison preserves fixed-width SGE accounting output.
fevc/qualification/inference_matlab/evidence/*qacct.txt whitespace=-blank-at-eol

# Windows controller receipts bind original CRLF bytes, not Git-normalized JSON.
rust/qualification/evidence/RC1-PLATFORMS/*/windows-receipt.json -text whitespace=cr-at-eol
rust/qualification/evidence/INFERENCE-WINDOWS/*/windows-receipt.json -text whitespace=cr-at-eol

# Preserve the fixed-width scheduler accounting bound by the Linux receipt.
rust/qualification/evidence/INFERENCE-LINUX-SCC/*/qacct.txt whitespace=-blank-at-eol
