#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N kss_nm

set -euo pipefail
for name in KSS_NM_RUN_DIR KSS_NM_SOURCE_DIR KSS_NM_SOURCE_COMMIT \
  KSS_NM_BUNDLE_SHA256 KSS_NM_EXPERIMENT_ID KSS_NM_TASK_SHA256 \
  KSS_NM_KSS_SOURCE_COMMIT KSS_NM_KSS_BUNDLE_SHA256 KSS_NM_WORKERS \
  KSS_NM_FIRMS KSS_NM_CELLS_PER_WORKER KSS_NM_ROWS_PER_CELL \
  KSS_NM_CONNECTIVITY KSS_NM_PROBES KSS_NM_SEED KSS_NM_MATLAB_ROOT \
  KSS_NM_CONTRACT_SHA256 KSS_NM_REQUESTED_SLOTS \
  KSS_NM_MEM_PER_CORE_GIB KSS_NM_HARD_WALL_SECONDS KSS_NM_OUTPUT_DIR \
  TMPDIR JOB_ID HOSTNAME; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done

[[ "$KSS_NM_RUN_DIR" == /projectnb/welfgr/fevc/runs/* ]]
[[ "$KSS_NM_SOURCE_DIR" == /projectnb/welfgr/fevc/bundles/*/source ]]
[[ "$KSS_NM_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$KSS_NM_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_NM_TASK_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_NM_KSS_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$KSS_NM_KSS_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_NM_EXPERIMENT_ID" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$KSS_NM_CONNECTIVITY" =~ ^(strong|weak)$ ]]
[[ "$KSS_NM_WORKERS" =~ ^[0-9]+$ ]]
[[ "$KSS_NM_FIRMS" =~ ^[0-9]+$ ]]
(( KSS_NM_WORKERS == 40 * KSS_NM_FIRMS ))
[[ "$KSS_NM_CELLS_PER_WORKER" =~ ^[2-7]$ ]]
[[ "$KSS_NM_ROWS_PER_CELL" =~ ^(1|8)$ ]]
[[ "$KSS_NM_PROBES" =~ ^[0-9]+$ ]] && (( KSS_NM_PROBES >= 2 ))
[[ "$KSS_NM_SEED" =~ ^[0-9]+$ ]] && (( KSS_NM_SEED <= 2147483646 ))
[[ "$KSS_NM_REQUESTED_SLOTS" == 4 ]]
test "${NSLOTS:-}" = "$KSS_NM_REQUESTED_SLOTS"
[[ "$KSS_NM_MEM_PER_CORE_GIB" =~ ^(14|32)$ ]]
[[ "$KSS_NM_HARD_WALL_SECONDS" =~ ^[0-9]+$ ]]
(( KSS_NM_HARD_WALL_SECONDS >= 600 && KSS_NM_HARD_WALL_SECONDS <= 42600 ))
case "$KSS_NM_MATLAB_ROOT" in
  /projectnb/welfgr/separations/*/LeaveOutTwoWay) ;;
  *) exit 198 ;;
esac
test "$KSS_NM_OUTPUT_DIR" = \
  "$KSS_NM_RUN_DIR/matlab_numopt2/$KSS_NM_EXPERIMENT_ID"
test "$(tr -d '[:space:]' < "$KSS_NM_RUN_DIR/source_commit.txt")" = \
  "$KSS_NM_SOURCE_COMMIT"
test "$(tr -d '[:space:]' < "$KSS_NM_RUN_DIR/bundle.sha256")" = \
  "$KSS_NM_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$KSS_NM_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$KSS_NM_SOURCE_COMMIT"
test "$(sha256sum "$KSS_NM_OUTPUT_DIR/task.tsv" | awk '{print $1}')" = \
  "$KSS_NM_TASK_SHA256"
bundle_dir=${KSS_NM_SOURCE_DIR%/source}
bundle_manifest="$bundle_dir/$KSS_NM_BUNDLE_SHA256.files.sha256"
(cd "$KSS_NM_SOURCE_DIR" && sha256sum -c "$bundle_manifest")

wrapper_complete=0
failure_stage=initialization
wrapper_failure() {
  local rc=$?
  if (( wrapper_complete == 0 )); then
    printf '%s\n' \
      "KSS_NUMOPT2_MATLAB_WRAPPER_FAILURE $KSS_NM_EXPERIMENT_ID stage=$failure_stage rc=$rc" \
      > "$KSS_NM_OUTPUT_DIR/wrapper.fail"
  fi
  exit "$rc"
}
trap wrapper_failure EXIT

failure_stage=module_setup
module purge
module load python3/3.12.4
module load matlab/2025b
python_bin=$(command -v python3)

failure_stage=scratch_setup
scratch="$TMPDIR/kss-numopt2-matlab-$JOB_ID"
case "$scratch" in "$TMPDIR"/*) ;; *) exit 198 ;; esac
test ! -e "$scratch"
mkdir -p "$scratch/mex" "$scratch/details" "$scratch/parallel"
chmod 700 "$scratch" "$scratch/mex" "$scratch/details" "$scratch/parallel"
export KSS_NM_SCRATCH_DIR="$scratch"
export KSS_NM_MEX_DIR="$scratch/mex"
export KSS_NM_SOURCE_IDENTITY="$KSS_NM_OUTPUT_DIR/source_identity.json"
export KSS_NM_PROCESS_IDENTITY="$KSS_NM_OUTPUT_DIR/process_identity.json"
export MATLAB_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

contract=\
"$KSS_NM_SOURCE_DIR/fevc/benchmarks/matlab_scale/source_contract.json"
driver_dir="$KSS_NM_SOURCE_DIR/fevc/benchmarks/scc"
monitor_dir="$KSS_NM_SOURCE_DIR/fevc/benchmarks/matlab_scale"
test "$(sha256sum "$contract" | awk '{print $1}')" = \
  "$KSS_NM_CONTRACT_SHA256"

failure_stage=maintained_source_identity
"$python_bin" "$driver_dir/verify_numopt2_matlab_source.py" \
  --matlab-root "$KSS_NM_MATLAB_ROOT" --contract "$contract" \
  --contract-sha256 "$KSS_NM_CONTRACT_SHA256" \
  --output "$KSS_NM_SOURCE_IDENTITY"

failure_stage=matlab_application
cd "$KSS_NM_SOURCE_DIR"
matlab_call="addpath('$driver_dir'); numopt2_matlab_run"
set +e
/usr/bin/time -v -o "$KSS_NM_OUTPUT_DIR/resources.txt" \
  /usr/bin/timeout --signal=TERM --kill-after=60 \
  "$KSS_NM_HARD_WALL_SECONDS" matlab -batch "$matlab_call" \
  > "$KSS_NM_OUTPUT_DIR/application.txt" 2>&1 &
application_pid=$!
"$python_bin" "$monitor_dir/monitor_process_tree.py" \
  --root-pid "$application_pid" --interval-seconds 0.25 \
  --expected-pool-workers 4 \
  --process-identity "$KSS_NM_PROCESS_IDENTITY" \
  --output "$KSS_NM_OUTPUT_DIR/process_tree_rss.json" \
  > "$KSS_NM_OUTPUT_DIR/process_tree_rss.monitor.txt" 2>&1
monitor_status=$?
wait "$application_pid"
matlab_status=$?
set -e
(( matlab_status == 0 )) || exit "$matlab_status"
(( monitor_status == 0 )) || exit "$monitor_status"

failure_stage=application_acceptance
grep -F "KSS_NUMOPT2 MATLAB PASS: $KSS_NM_EXPERIMENT_ID" \
  "$KSS_NM_OUTPUT_DIR/application.txt"
test -s "$KSS_NM_OUTPUT_DIR/aggregate.json"
test -s "$KSS_NM_OUTPUT_DIR/calls.csv"
test -s "$KSS_NM_OUTPUT_DIR/matlab.pass"
(cd "$KSS_NM_SOURCE_DIR" && sha256sum -c "$bundle_manifest")

{
  printf 'key\tvalue\n'
  printf 'receipt_version\tKSS-NUMOPT-2-MATLAB-NODE-V1\n'
  printf 'experiment_id\t%s\n' "$KSS_NM_EXPERIMENT_ID"
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$KSS_NM_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$KSS_NM_BUNDLE_SHA256"
  printf 'kss_source_commit\t%s\n' "$KSS_NM_KSS_SOURCE_COMMIT"
  printf 'kss_bundle_sha256\t%s\n' "$KSS_NM_KSS_BUNDLE_SHA256"
  printf 'task_sha256\t%s\n' "$KSS_NM_TASK_SHA256"
  printf 'requested_slots\t%s\n' "$KSS_NM_REQUESTED_SLOTS"
  printf 'actual_slots\t%s\n' "${NSLOTS:-}"
  printf 'mem_per_core_gib\t%s\n' "$KSS_NM_MEM_PER_CORE_GIB"
  printf 'hard_wall_seconds\t%s\n' "$KSS_NM_HARD_WALL_SECONDS"
} > "$KSS_NM_OUTPUT_DIR/node_receipt.tsv"
printf '%s\n' \
  "KSS_NUMOPT2_MATLAB_WRAPPER_PASS $KSS_NM_EXPERIMENT_ID $KSS_NM_TASK_SHA256" \
  > "$KSS_NM_OUTPUT_DIR/wrapper.pass"
wrapper_complete=1
failure_stage=complete
trap - EXIT
printf '%s\n' "KSS-NUMOPT-2 MATLAB SCC PASS: $KSS_NM_EXPERIMENT_ID"
