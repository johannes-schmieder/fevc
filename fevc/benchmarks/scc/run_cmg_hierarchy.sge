#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -N cmg_hier

set -euo pipefail
for name in CMG_H_RUN_DIR CMG_H_SOURCE_DIR CMG_H_SOURCE_COMMIT \
  CMG_H_BUNDLE_SHA256 CMG_H_EXPERIMENT CMG_H_KIND CMG_H_ARG1 \
  CMG_H_ARG2 CMG_H_ARG3 CMG_H_ARG4 CMG_H_REQUESTED_SLOTS \
  CMG_H_STATA_PROCESSORS CMG_H_OUTPUT_DIR TMPDIR JOB_ID HOSTNAME; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done

[[ "$CMG_H_RUN_DIR" == /projectnb/welfgr/fevc/runs/* ]]
test "$CMG_H_SOURCE_DIR" = \
  "/projectnb/welfgr/fevc/bundles/$CMG_H_BUNDLE_SHA256/source"
[[ "$CMG_H_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$CMG_H_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$CMG_H_EXPERIMENT" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$CMG_H_KIND" =~ ^(degree|family)$ ]]
[[ "$CMG_H_REQUESTED_SLOTS" =~ ^[0-9]+$ ]]
[[ "$CMG_H_STATA_PROCESSORS" =~ ^[0-9]+$ ]]
test "${NSLOTS:-}" = "$CMG_H_REQUESTED_SLOTS"
(( CMG_H_STATA_PROCESSORS >= 1 &&
   CMG_H_STATA_PROCESSORS <= CMG_H_REQUESTED_SLOTS ))
test "$CMG_H_OUTPUT_DIR" = \
  "$CMG_H_RUN_DIR/hierarchy/$CMG_H_EXPERIMENT"
test "$(tr -d '[:space:]' < "$CMG_H_RUN_DIR/source_commit.txt")" = \
  "$CMG_H_SOURCE_COMMIT"
test "$(tr -d '[:space:]' < "$CMG_H_RUN_DIR/bundle.sha256")" = \
  "$CMG_H_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$CMG_H_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$CMG_H_SOURCE_COMMIT"
(cd "$CMG_H_SOURCE_DIR" && sha256sum -c BUNDLE_FILES.sha256)

complete=0
failure() {
  local rc=$?
  if (( complete == 0 )); then
    printf 'CMG_HIERARCHY_WRAPPER_FAILURE %s rc=%s\n' \
      "$CMG_H_EXPERIMENT" "$rc" > "$CMG_H_OUTPUT_DIR/wrapper.fail"
  fi
  exit "$rc"
}
trap failure EXIT

module purge
module load stata-mp/19
export OMP_NUM_THREADS="$CMG_H_STATA_PROCESSORS"
export STATATMP="$TMPDIR/cmg-hierarchy-$JOB_ID"
mkdir -p "$STATATMP"
cd "$CMG_H_SOURCE_DIR"

if [[ "$CMG_H_KIND" == degree ]]; then
  /usr/bin/time -v -o "$CMG_H_OUTPUT_DIR/resources.txt" \
    stata-mp -q do fevc/cmg/benchmarks/degree_hierarchy_matrix.do \
      "$CMG_H_SOURCE_DIR" "$CMG_H_OUTPUT_DIR/results.csv" \
      "$CMG_H_ARG1" "$CMG_H_ARG2" "$CMG_H_ARG3" "$CMG_H_ARG4" \
      > "$CMG_H_OUTPUT_DIR/application.log" 2>&1
  grep -F 'CMG DEGREE HIERARCHY MATRIX PASS' \
    "$CMG_H_OUTPUT_DIR/application.log"
else
  /usr/bin/time -v -o "$CMG_H_OUTPUT_DIR/resources.txt" \
    stata-mp -q do fevc/cmg/benchmarks/hierarchy_benchmark.do \
      "$CMG_H_SOURCE_DIR" "$CMG_H_ARG1" "$CMG_H_ARG2" \
      "$CMG_H_OUTPUT_DIR/results.csv" "$CMG_H_ARG3" \
      > "$CMG_H_OUTPUT_DIR/application.log" 2>&1
  grep -F 'CMG HIERARCHY BENCHMARK PASS' \
    "$CMG_H_OUTPUT_DIR/application.log"
fi
test -s "$CMG_H_OUTPUT_DIR/results.csv"
{
  printf 'key\tvalue\n'
  printf 'receipt_version\tCMG-MATA-1-HIERARCHY-NODE-V1\n'
  printf 'experiment_id\t%s\n' "$CMG_H_EXPERIMENT"
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$CMG_H_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$CMG_H_BUNDLE_SHA256"
  printf 'requested_slots\t%s\n' "$CMG_H_REQUESTED_SLOTS"
  printf 'actual_slots\t%s\n' "${NSLOTS:-}"
  printf 'stata_processors\t%s\n' "$CMG_H_STATA_PROCESSORS"
} > "$CMG_H_OUTPUT_DIR/node_receipt.tsv"
printf 'CMG_HIERARCHY_WRAPPER_PASS %s\n' "$CMG_H_EXPERIMENT" \
  > "$CMG_H_OUTPUT_DIR/wrapper.pass"
complete=1
trap - EXIT
printf 'CMG-MATA-1 HIERARCHY SCC PASS: %s\n' "$CMG_H_EXPERIMENT"
