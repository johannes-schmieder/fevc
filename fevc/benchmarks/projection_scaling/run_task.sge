#!/bin/bash -l
#$ -clear
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -N vps_pair
#$ -pe omp 4
#$ -binding linear:4
#$ -l h_rt=06:00:00
#$ -l mem_per_core=4G
set -euo pipefail
test -n "${VPS_RUN_DIR:-}" && test "$NSLOTS" = 4
[[ "$SGE_TASK_ID" =~ ^[1-9]$ ]]
case $(((SGE_TASK_ID-1)/3)) in
  0) rows=6000 ;;
  1) rows=24000 ;;
  2) rows=96000 ;;
  *) exit 198 ;;
esac
replicate=$((1+(SGE_TASK_ID-1)%3))
harness=$VPS_RUN_DIR/source/fevc/benchmarks/projection_scaling
output=$VPS_RUN_DIR/tasks/task-$SGE_TASK_ID
"$harness/run_pair.sh" "$VPS_RUN_DIR" "$rows" "$replicate" "$output" 0
module purge
module load python3/3.12.4
python3 "$harness/validate.py" --pair "$output" \
  --output "$output/validation.json"
