#!/bin/bash -l
#$ -cwd
#$ -j y
#$ -P welfgr
#$ -pe omp 4
#$ -l h_rt=03:00:00
#$ -l mem_per_core=4G
#$ -m a

set -euo pipefail
module load stata-mp/19
: "${TMPDIR:?}"
: "${PREP_BND_ROOT:?}"
: "${PREP_BND_RUN:?}"
: "${PREP_BND_BASELINE:?}"
: "${PREP_BND_CANDIDATE:?}"
: "${PREP_BND_BASELINE_BUNDLE_SHA256:?}"
: "${PREP_BND_CANDIDATE_BUNDLE_SHA256:?}"
: "${PREP_BND_DRIVER_SHA256:?}"
: "${PREP_BND_FIRMS:?}"
: "${PREP_BND_PROBES:?}"
: "${PREP_BND_ORDER:?}"
: "${PREP_BND_REPETITIONS:=3}"
[[ "${PREP_BND_BASELINE}" =~ ^[0-9a-f]{40}$ ]]
[[ "${PREP_BND_CANDIDATE}" =~ ^[0-9a-f]{40}$ ]]
[[ "${PREP_BND_BASELINE_BUNDLE_SHA256}" =~ ^[0-9a-f]{64}$ ]]
[[ "${PREP_BND_CANDIDATE_BUNDLE_SHA256}" =~ ^[0-9a-f]{64}$ ]]
[[ "${PREP_BND_DRIVER_SHA256}" =~ ^[0-9a-f]{64}$ ]]
[[ "${PREP_BND_FIRMS}" =~ ^(256|1024|4096|8192)$ ]]
[[ "${PREP_BND_PROBES}" == 256 ]]
[[ "${PREP_BND_ORDER}" =~ ^(ab|ba)$ ]]
[[ "${PREP_BND_REPETITIONS}" == 3 ]]

baseline_bundle="${PREP_BND_ROOT}/bundles/${PREP_BND_BASELINE}.tar"
candidate_bundle="${PREP_BND_ROOT}/bundles/${PREP_BND_CANDIDATE}.tar"
driver="${PREP_BND_ROOT}/driver/${PREP_BND_DRIVER_SHA256}.do"
test "$(sha256sum "${baseline_bundle}" | awk '{print $1}')" = "${PREP_BND_BASELINE_BUNDLE_SHA256}"
test "$(sha256sum "${candidate_bundle}" | awk '{print $1}')" = "${PREP_BND_CANDIDATE_BUNDLE_SHA256}"
test "$(sha256sum "${driver}" | awk '{print $1}')" = "${PREP_BND_DRIVER_SHA256}"

case_name="F${PREP_BND_FIRMS}-P${PREP_BND_PROBES}"
result_root="${PREP_BND_ROOT}/runs/${PREP_BND_RUN}/${case_name}-${PREP_BND_ORDER}"
test ! -e "${result_root}"
job_root="${TMPDIR}/prep-bnd1-${case_name}-${PREP_BND_ORDER}"
mkdir -p "${job_root}/baseline" "${job_root}/candidate" "${result_root}"
tar -xf "${baseline_bundle}" -C "${job_root}/baseline"
tar -xf "${candidate_bundle}" -C "${job_root}/candidate"

if [[ "${PREP_BND_ORDER}" == ab ]]; then roles=(baseline candidate); else roles=(candidate baseline); fi
for role in "${roles[@]}"; do
    if [[ "${role}" == baseline ]]; then commit="${PREP_BND_BASELINE}"; else commit="${PREP_BND_CANDIDATE}"; fi
    export STATATMP="${TMPDIR}/stata-${role}"
    mkdir -p "${STATATMP}"
    /usr/bin/time -v -o "${result_root}/${role}_resources.txt" \
      /usr/bin/timeout --signal=TERM --kill-after=60 5000 \
      stata-mp -q do "${driver}" "${job_root}/${role}" \
        "${result_root}/${role}.csv" "${result_root}/${role}_profiles.csv" \
        "${role}" "${commit}" "${PREP_BND_FIRMS}" "${PREP_BND_PROBES}" \
        "${PREP_BND_REPETITIONS}" scc >"${result_root}/${role}.log" 2>&1
    # Stata wraps long display lines at its active line size.  Match the
    # role+full-commit prefix, while the wrapper independently binds the case.
    grep -F "KSS_PREP_BND1_SCC_PASS ${role} ${commit}" \
      "${result_root}/${role}.log"
done

{
    printf 'key\tvalue\n'
    printf 'schema\tvckss-prep-bnd1-node-v1\n'
    printf 'job_id\t%s\n' "${JOB_ID:?}"
    printf 'hostname\t%s\n' "${HOSTNAME:?}"
    printf 'case\t%s\n' "${case_name}"
    printf 'order\t%s\n' "${PREP_BND_ORDER}"
    printf 'baseline\t%s\n' "${PREP_BND_BASELINE}"
    printf 'candidate\t%s\n' "${PREP_BND_CANDIDATE}"
    printf 'baseline_bundle_sha256\t%s\n' "${PREP_BND_BASELINE_BUNDLE_SHA256}"
    printf 'candidate_bundle_sha256\t%s\n' "${PREP_BND_CANDIDATE_BUNDLE_SHA256}"
    printf 'driver_sha256\t%s\n' "${PREP_BND_DRIVER_SHA256}"
    printf 'input_sha256\tGENERATED_DETERMINISTIC\n'
    printf 'requested_slots\t4\n'
    printf 'stata_processors\t4\n'
    printf 'reserved_memory_gib\t16\n'
    printf 'repetitions\t%s\n' "${PREP_BND_REPETITIONS}"
} >"${result_root}/node_receipt.tsv"
marker="PREP_BND1_PAIR_PASS ${case_name} ${PREP_BND_ORDER} baseline=${PREP_BND_BASELINE} candidate=${PREP_BND_CANDIDATE}"
printf '%s\n' "${marker}" >"${result_root}/pair.pass"
printf '%s\n' "${marker}"
