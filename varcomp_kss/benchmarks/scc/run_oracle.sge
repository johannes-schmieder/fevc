#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 4
#$ -l h_rt=02:00:00
#$ -l mem_per_core=4G
#$ -N kss_oracle

set -euo pipefail
: "${KSS_RUN_DIR:?KSS_RUN_DIR is required}"
: "${KSS_SOURCE_DIR:?KSS_SOURCE_DIR is required}"
: "${KSS_SOURCE_COMMIT:?KSS_SOURCE_COMMIT is required}"

test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$KSS_SOURCE_COMMIT"
module purge
module load matlab/2024b

job_dir="$KSS_RUN_DIR/oracle"
mkdir -p "$job_dir"
cd "$KSS_SOURCE_DIR"

/usr/bin/time -v -o "$job_dir/matlab.resources.txt" \
  matlab -singleCompThread -batch "addpath('varcomp_kss/benchmarks/oracle'); varcomp_kss_dense_oracle('$job_dir','$KSS_SOURCE_COMMIT')" \
  > "$job_dir/matlab.application.txt" 2>&1

module purge
module load stata-mp/19
/usr/bin/time -v -o "$job_dir/stata.resources.txt" \
  stata-mp -q do varcomp_kss/benchmarks/oracle/stata_oracle.do \
  "$job_dir" "$KSS_SOURCE_COMMIT" \
  > "$job_dir/stata.application.txt" 2>&1

test -f "$job_dir/oracle.stata.pass"
grep -F "VARCOMP_KSS MATLAB ORACLE PASS" "$job_dir/matlab.application.txt"
grep -F "VARCOMP_KSS STATA/MATLAB ORACLE PASS" "$job_dir/stata.application.txt"
printf '%s\n' "VARCOMP_KSS_ORACLE_PASS $KSS_SOURCE_COMMIT" > "$job_dir/oracle.wrapper.pass"
printf '%s\n' "VARCOMP_KSS SCC ORACLE PASS"
