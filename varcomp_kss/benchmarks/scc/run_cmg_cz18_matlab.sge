#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N cmg_cz_m

set -euo pipefail
for name in CMG_CZ_M_RUN_DIR CMG_CZ_M_SOURCE_DIR CMG_CZ_M_SOURCE_COMMIT \
  CMG_CZ_M_BUNDLE_SHA256 CMG_CZ_M_EXPERIMENT CMG_CZ_M_TASK_SHA256 \
  CMG_CZ_M_INPUT_DTA CMG_CZ_M_INPUT_SHA256 CMG_CZ_M_PROBES \
  CMG_CZ_M_SEED CMG_CZ_M_MATLAB_ROOT CMG_CZ_M_CONTRACT_SHA256 \
  CMG_CZ_M_HARD_WALL_SECONDS CMG_CZ_M_REQUESTED_SLOTS \
  CMG_CZ_M_MEM_PER_CORE_GIB CMG_CZ_M_OUTPUT_DIR TMPDIR JOB_ID HOSTNAME; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done

[[ "$CMG_CZ_M_RUN_DIR" == /projectnb/welfgr/varcomp-kss/runs/* ]]
test "$CMG_CZ_M_SOURCE_DIR" = \
  "/projectnb/welfgr/varcomp-kss/bundles/$CMG_CZ_M_BUNDLE_SHA256/source"
[[ "$CMG_CZ_M_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$CMG_CZ_M_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$CMG_CZ_M_EXPERIMENT" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$CMG_CZ_M_TASK_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$CMG_CZ_M_INPUT_SHA256" =~ ^[0-9a-f]{64}$ ]]
test "$CMG_CZ_M_PROBES" = 20
test "$CMG_CZ_M_SEED" = 8675309
test "$CMG_CZ_M_REQUESTED_SLOTS" = 4
test "${NSLOTS:-}" = 4
[[ "$CMG_CZ_M_MEM_PER_CORE_GIB" =~ ^(14|32)$ ]]
[[ "$CMG_CZ_M_HARD_WALL_SECONDS" =~ ^[0-9]+$ ]]
(( CMG_CZ_M_HARD_WALL_SECONDS >= 600 &&
   CMG_CZ_M_HARD_WALL_SECONDS <= 42600 ))
case "$CMG_CZ_M_INPUT_DTA" in /projectnb/welfgr/*) ;; *) exit 198 ;; esac
case "$CMG_CZ_M_MATLAB_ROOT" in
  /projectnb/welfgr/separations/*/LeaveOutTwoWay) ;;
  *) exit 198 ;;
esac
test "$CMG_CZ_M_OUTPUT_DIR" = \
  "$CMG_CZ_M_RUN_DIR/matlab_cz18/$CMG_CZ_M_EXPERIMENT"
test "$(tr -d '[:space:]' < "$CMG_CZ_M_RUN_DIR/source_commit.txt")" = \
  "$CMG_CZ_M_SOURCE_COMMIT"
test "$(tr -d '[:space:]' < "$CMG_CZ_M_RUN_DIR/bundle.sha256")" = \
  "$CMG_CZ_M_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$CMG_CZ_M_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$CMG_CZ_M_SOURCE_COMMIT"
test "$(sha256sum "$CMG_CZ_M_INPUT_DTA" | awk '{print $1}')" = \
  "$CMG_CZ_M_INPUT_SHA256"
test "$(sha256sum "$CMG_CZ_M_OUTPUT_DIR/task.tsv" | awk '{print $1}')" = \
  "$CMG_CZ_M_TASK_SHA256"
bundle_dir=${CMG_CZ_M_SOURCE_DIR%/source}
(cd "$CMG_CZ_M_SOURCE_DIR" && sha256sum -c \
  "$bundle_dir/$CMG_CZ_M_BUNDLE_SHA256.files.sha256")

wrapper_complete=0
failure_stage=initialization
failure() {
  local rc=$?
  if (( wrapper_complete == 0 )); then
    printf 'CMG_MATA1_CZ18_MATLAB_WRAPPER_FAILURE %s stage=%s rc=%s\n' \
      "$CMG_CZ_M_EXPERIMENT" "$failure_stage" "$rc" \
      > "$CMG_CZ_M_OUTPUT_DIR/wrapper.fail"
  fi
  exit "$rc"
}
trap failure EXIT

failure_stage=scratch_setup
scratch="$TMPDIR/cmg-mata1-cz18-matlab-$JOB_ID"
case "$scratch" in "$TMPDIR"/*) ;; *) exit 198 ;; esac
test ! -e "$scratch"
mkdir -p "$scratch/input" "$scratch/mex" "$scratch/details" \
  "$scratch/parallel" "$scratch/stata"
chmod 700 "$scratch" "$scratch/input" "$scratch/mex" "$scratch/details" \
  "$scratch/parallel" "$scratch/stata"
staging_started=$(date +%s)
cp "$CMG_CZ_M_INPUT_DTA" "$scratch/input/retained_sample.dta"
test "$(sha256sum "$scratch/input/retained_sample.dta" | awk '{print $1}')" = \
  "$CMG_CZ_M_INPUT_SHA256"
staging_seconds=$(( $(date +%s) - staging_started ))

failure_stage=stata_preparation
module purge
module load stata-mp/19
export OMP_NUM_THREADS=4
export STATATMP="$scratch/stata"
cd "$CMG_CZ_M_SOURCE_DIR"
/usr/bin/time -v -o "$CMG_CZ_M_OUTPUT_DIR/prepare_resources.txt" \
  stata-mp -q do varcomp_kss/benchmarks/scc/cmg_cz18_matlab_prepare.do \
    "$scratch/input/retained_sample.dta" "$scratch/input/input.csv" \
    "$CMG_CZ_M_OUTPUT_DIR/prepare.csv" "$CMG_CZ_M_EXPERIMENT" \
    "$CMG_CZ_M_INPUT_SHA256" "$CMG_CZ_M_SOURCE_COMMIT" \
    "$CMG_CZ_M_BUNDLE_SHA256" 4 \
    > "$CMG_CZ_M_OUTPUT_DIR/prepare_application.txt" 2>&1
grep -F "CMG-MATA-1 CZ18 MATLAB PREPARE PASS: $CMG_CZ_M_EXPERIMENT" \
  "$CMG_CZ_M_OUTPUT_DIR/prepare_application.txt"
test -s "$scratch/input/input.csv"
prepared_sha=$(sha256sum "$scratch/input/input.csv" | awk '{print $1}')
[[ "$prepared_sha" =~ ^[0-9a-f]{64}$ ]]
printf '%s\n' "$prepared_sha" > "$CMG_CZ_M_OUTPUT_DIR/prepared_input.sha256"
export CMG_CZ_M_PREPARED_INPUT_SHA256="$prepared_sha"

failure_stage=module_setup
module purge
module load python3/3.12.4
module load matlab/2025b
python_bin=$(command -v python3)
contract=\
"$CMG_CZ_M_SOURCE_DIR/varcomp_kss/benchmarks/matlab_scale/source_contract.json"
test "$(sha256sum "$contract" | awk '{print $1}')" = \
  "$CMG_CZ_M_CONTRACT_SHA256"
driver_dir="$CMG_CZ_M_SOURCE_DIR/varcomp_kss/benchmarks/scc"
monitor_dir="$CMG_CZ_M_SOURCE_DIR/varcomp_kss/benchmarks/matlab_scale"
export CMG_CZ_M_SCRATCH_DIR="$scratch"
export CMG_CZ_M_INPUT_CSV="$scratch/input/input.csv"
export CMG_CZ_M_SOURCE_IDENTITY="$CMG_CZ_M_OUTPUT_DIR/source_identity.json"
export CMG_CZ_M_PROCESS_IDENTITY="$CMG_CZ_M_OUTPUT_DIR/process_identity.json"
export CMG_CZ_M_ROWS=8201888
export CMG_CZ_M_WORKERS=117529
export CMG_CZ_M_FIRMS=10603
export CMG_CZ_M_CELLS=311730
export MATLAB_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

failure_stage=maintained_source_identity
"$python_bin" "$driver_dir/verify_numopt2_matlab_source.py" \
  --matlab-root "$CMG_CZ_M_MATLAB_ROOT" --contract "$contract" \
  --contract-sha256 "$CMG_CZ_M_CONTRACT_SHA256" \
  --output "$CMG_CZ_M_SOURCE_IDENTITY"

failure_stage=matlab_application
matlab_call="addpath('$driver_dir'); cmg_cz18_matlab_run"
set +e
/usr/bin/time -v -o "$CMG_CZ_M_OUTPUT_DIR/matlab_resources.txt" \
  /usr/bin/timeout --signal=TERM --kill-after=60 \
  "$CMG_CZ_M_HARD_WALL_SECONDS" matlab -batch "$matlab_call" \
  > "$CMG_CZ_M_OUTPUT_DIR/application.txt" 2>&1 &
application_pid=$!
"$python_bin" "$monitor_dir/monitor_process_tree.py" \
  --root-pid "$application_pid" --interval-seconds 0.25 \
  --expected-pool-workers 4 \
  --process-identity "$CMG_CZ_M_PROCESS_IDENTITY" \
  --output "$CMG_CZ_M_OUTPUT_DIR/process_tree_rss.json" \
  > "$CMG_CZ_M_OUTPUT_DIR/process_tree_rss.monitor.txt" 2>&1
monitor_status=$?
wait "$application_pid"
matlab_status=$?
set -e
test "$matlab_status" = 0
test "$monitor_status" = 0
grep -F "CMG-MATA-1 CZ18 MATLAB PASS: $CMG_CZ_M_EXPERIMENT" \
  "$CMG_CZ_M_OUTPUT_DIR/application.txt"
test -s "$CMG_CZ_M_OUTPUT_DIR/aggregate.json"
test -s "$CMG_CZ_M_OUTPUT_DIR/process_identity.json"
test -s "$CMG_CZ_M_OUTPUT_DIR/process_tree_rss.json"
test -s "$CMG_CZ_M_OUTPUT_DIR/matlab.pass"

failure_stage=receipt
{
  printf 'key\tvalue\n'
  printf 'receipt_version\tCMG-MATA-1-CZ18-MATLAB-NODE-V1\n'
  printf 'experiment_id\t%s\n' "$CMG_CZ_M_EXPERIMENT"
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$CMG_CZ_M_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$CMG_CZ_M_BUNDLE_SHA256"
  printf 'input_sha256\t%s\n' "$CMG_CZ_M_INPUT_SHA256"
  printf 'prepared_input_sha256\t%s\n' "$prepared_sha"
  printf 'requested_slots\t4\n'
  printf 'actual_slots\t%s\n' "${NSLOTS:-}"
  printf 'matlab_pool_workers\t4\n'
  printf 'stata_prepare_processors\t4\n'
  printf 'staging_seconds\t%s\n' "$staging_seconds"
} > "$CMG_CZ_M_OUTPUT_DIR/node_receipt.tsv"
printf 'CMG_MATA1_CZ18_MATLAB_WRAPPER_PASS %s\n' \
  "$CMG_CZ_M_EXPERIMENT" > "$CMG_CZ_M_OUTPUT_DIR/wrapper.pass"
wrapper_complete=1
trap - EXIT
printf 'CMG-MATA-1 CZ18 MATLAB SCC PASS: %s\n' "$CMG_CZ_M_EXPERIMENT"
