#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 4
#$ -l h_rt=18:00:00
#$ -l mem_per_core=4G
#$ -N kss_scale

set -euo pipefail
: "${KSS_RUN_DIR:?KSS_RUN_DIR is required}"
: "${KSS_SOURCE_DIR:?KSS_SOURCE_DIR is required}"
: "${KSS_SOURCE_COMMIT:?KSS_SOURCE_COMMIT is required}"
: "${KSS_SCENARIO:?KSS_SCENARIO is required}"
: "${KSS_WORKERS:?KSS_WORKERS is required}"
: "${KSS_FIRMS:?KSS_FIRMS is required}"
: "${KSS_PROBES:?KSS_PROBES is required}"
: "${KSS_SEED:?KSS_SEED is required}"

test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$KSS_SOURCE_COMMIT"
case "$KSS_SCENARIO" in
  smoke|medium|large) ;;
  *) printf '%s\n' "invalid scale scenario: $KSS_SCENARIO" >&2; exit 198 ;;
esac

module purge
module load stata-mp/19
export OMP_NUM_THREADS="${NSLOTS:-4}"

job_dir="$KSS_RUN_DIR/scale/$KSS_SCENARIO"
mkdir -p "$job_dir"
cd "$KSS_SOURCE_DIR"

/usr/bin/time -v -o "$job_dir/resources.txt" \
  stata-mp -q do varcomp_kss/benchmarks/synthetic_benchmark.do \
  "$KSS_RUN_ID" "$KSS_SCENARIO" "$KSS_WORKERS" "$KSS_FIRMS" \
  "$KSS_PROBES" "$KSS_SEED" "$job_dir" "$KSS_SOURCE_COMMIT" \
  > "$job_dir/$KSS_SCENARIO.application.txt" 2>&1

test -f "$job_dir/$KSS_SCENARIO.stata.pass"
test -s "$job_dir/$KSS_SCENARIO.csv"
grep -F "VARCOMP_KSS BENCHMARK PASS: $KSS_SCENARIO" \
  "$job_dir/$KSS_SCENARIO.application.txt"
printf '%s\n' "VARCOMP_KSS_SCALE_PASS $KSS_SCENARIO $KSS_SOURCE_COMMIT" \
  > "$job_dir/$KSS_SCENARIO.wrapper.pass"
printf '%s\n' "VARCOMP_KSS SCC SCALE PASS: $KSS_SCENARIO"
