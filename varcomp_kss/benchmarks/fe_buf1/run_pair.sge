#!/bin/bash -l
#$ -cwd
#$ -j y
#$ -P welfgr
#$ -pe omp 4
#$ -l h_rt=02:00:00
#$ -l mem_per_core=8G

set -euo pipefail
module load stata-mp/19
: "${TMPDIR:?}"
: "${FE_BUF_ROOT:?}"
: "${FE_BUF_RUN:?}"
: "${FE_BUF_FIRMS:?}"
: "${FE_BUF_PROBES:?}"
: "${FE_BUF_ORDER:?}"

baseline=7f5a38b49cccd5bf0396f62fedd542881d68bad1
candidate=1cb441f20be0d747483cd8f81746af4187192d0f
job_root="${TMPDIR}/fe-buf1"
result_root="${FE_BUF_ROOT}/runs/${FE_BUF_RUN}/F${FE_BUF_FIRMS}-P${FE_BUF_PROBES}-${FE_BUF_ORDER}"
mkdir -p "${job_root}/baseline" "${job_root}/candidate" "${result_root}"
tar -xf "${FE_BUF_ROOT}/bundles/${baseline}.tar" -C "${job_root}/baseline"
tar -xf "${FE_BUF_ROOT}/bundles/${candidate}.tar" -C "${job_root}/candidate"

if [[ "${FE_BUF_ORDER}" == "ab" ]]; then roles=(baseline candidate); else roles=(candidate baseline); fi
for role in "${roles[@]}"; do
    if [[ "${role}" == "baseline" ]]; then commit="${baseline}"; else commit="${candidate}"; fi
    log="${result_root}/${role}.log"
    csv="${result_root}/${role}.csv"
    stata-mp -q do "${FE_BUF_ROOT}/driver/scc_driver.do" \
        "${job_root}/${role}" "${csv}" "${role}" "${commit}" \
        "${FE_BUF_FIRMS}" "${FE_BUF_PROBES}" >"${log}" 2>&1
    # Stata wraps long display lines at the batch terminal width.  Bind the
    # role and full source commit in the unwrapped prefix; F/P are validated
    # from the CSV dimensions and result path.
    grep -F "KSS_FE_BUF1_SCC_PASS ${role} ${commit}" "${log}"
done
printf '%s\n' "FE_BUF1_PAIR_PASS F${FE_BUF_FIRMS} P${FE_BUF_PROBES} ${FE_BUF_ORDER}" >"${result_root}/pair.pass"
