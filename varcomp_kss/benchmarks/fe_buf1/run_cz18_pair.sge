#!/bin/bash -l
#$ -cwd
#$ -j y
#$ -P welfgr
#$ -pe omp 14
#$ -l h_rt=03:00:00
#$ -l mem_per_core=4G

set -euo pipefail
module load stata-mp/19
: "${TMPDIR:?}"
: "${FE_BUF_ROOT:?}"
: "${FE_BUF_RUN:?}"
: "${FE_BUF_ORDER:?}"
: "${FE_BUF_CZ18_INPUT:?}"

baseline=7f5a38b49cccd5bf0396f62fedd542881d68bad1
candidate=1cb441f20be0d747483cd8f81746af4187192d0f
baseline_tar_sha=61f15ae1fc380b8db429f9c342cb6274c16724ec91c659590be48f426e306321
candidate_tar_sha=ec25639b6a42ea22d7b114ded94a7fe4cca56350b659eeea8b4147c16d1f342b
input_sha=1748ca2a6a46f248e05c0329407e7e7708ec7628c1ffce5f0e06ee264bdf0575
driver_sha=3cf8e02ccb8cd99240af5ceff2f3ddc8a10ca2742225aee658c7af5c4658f668
[[ "${FE_BUF_ORDER}" =~ ^(ab|ba)$ ]]
test "$(sha256sum "${FE_BUF_CZ18_INPUT}" | awk '{print $1}')" = "${input_sha}"
driver="${FE_BUF_ROOT}/driver/${driver_sha}.do"
test "$(sha256sum "${driver}" | awk '{print $1}')" = "${driver_sha}"
test "$(sha256sum "${FE_BUF_ROOT}/bundles/${baseline}.tar" | awk '{print $1}')" = "${baseline_tar_sha}"
test "$(sha256sum "${FE_BUF_ROOT}/bundles/${candidate}.tar" | awk '{print $1}')" = "${candidate_tar_sha}"

job_root="${TMPDIR}/fe-buf1-cz18"
result_root="${FE_BUF_ROOT}/runs/${FE_BUF_RUN}/CZ18-P20-${FE_BUF_ORDER}"
test ! -e "${result_root}"
mkdir -p "${job_root}/baseline" "${job_root}/candidate" "${result_root}"
tar -xf "${FE_BUF_ROOT}/bundles/${baseline}.tar" -C "${job_root}/baseline"
tar -xf "${FE_BUF_ROOT}/bundles/${candidate}.tar" -C "${job_root}/candidate"

if [[ "${FE_BUF_ORDER}" == ab ]]; then roles=(baseline candidate); else roles=(candidate baseline); fi
for round in 1 2 3; do
    for role in "${roles[@]}"; do
        if [[ "${role}" == baseline ]]; then commit="${baseline}"; else commit="${candidate}"; fi
        output_dir="${result_root}/round${round}-${role}"
        mkdir -p "${output_dir}"
        export STATATMP="${TMPDIR}/stata-${role}-${round}"
        mkdir -p "${STATATMP}"
        log="${output_dir}/application.log"
        csv="${output_dir}/summary.csv"
        /usr/bin/time -v -o "${output_dir}/resources.txt" \
          /usr/bin/timeout --signal=TERM --kill-after=60 1800 \
          stata-mp -q do "${driver}" \
            "${job_root}/${role}" "${FE_BUF_CZ18_INPUT}" "${csv}" \
            "${role}" "${commit}" "${FE_BUF_ORDER}" "${round}" \
            >"${log}" 2>&1
        grep -F "KSS_FE_BUF1_CZ18_PASS ${role} ${commit} ${FE_BUF_ORDER} R${round}" "${log}"
        test -s "${csv}"
    done
done

{
    printf 'key\tvalue\n'
    printf 'schema\tvarcomp-kss-fe-buf1-cz18-node-v1\n'
    printf 'job_id\t%s\n' "${JOB_ID:?}"
    printf 'hostname\t%s\n' "${HOSTNAME:?}"
    printf 'order\t%s\n' "${FE_BUF_ORDER}"
    printf 'input_sha256\t%s\n' "${input_sha}"
    printf 'baseline\t%s\n' "${baseline}"
    printf 'candidate\t%s\n' "${candidate}"
    printf 'driver_sha256\t%s\n' "${driver_sha}"
    printf 'requested_slots\t14\n'
    printf 'stata_processors\t4\n'
    printf 'reserved_memory_gib\t56\n'
} >"${result_root}/node_receipt.tsv"
printf '%s\n' "FE_BUF1_CZ18_PAIR_PASS P20 ${FE_BUF_ORDER}" >"${result_root}/pair.pass"
