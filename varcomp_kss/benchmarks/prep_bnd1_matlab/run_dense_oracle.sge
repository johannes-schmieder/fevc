#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N pbm_dense_oracle
#$ -pe omp 4
#$ -l h_rt=00:20:00
#$ -l mem_per_core=4G

# Non-submitting SCC wrapper for the independent clean-room dense oracle.
# It never reads or verifies any maintained comparator source tree.
set -euo pipefail
for name in PBM_ROOT PBM_RUN_ID PBM_SOURCE_DIR PBM_SOURCE_COMMIT \
  PBM_BUNDLE_SHA256 PBM_BUNDLE_MANIFEST TMPDIR JOB_ID HOSTNAME NSLOTS; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done
[[ "$PBM_ROOT" == /projectnb/welfgr/varcomp-kss/prep-bnd1-matlab ]]
[[ "$PBM_RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$PBM_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$PBM_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
test "$PBM_SOURCE_DIR" = \
  "/projectnb/welfgr/varcomp-kss/bundles/$PBM_BUNDLE_SHA256/source"
test "$PBM_BUNDLE_MANIFEST" = \
  "/projectnb/welfgr/varcomp-kss/bundles/$PBM_BUNDLE_SHA256.files.sha256"
bundle_archive="/projectnb/welfgr/varcomp-kss/bundles/$PBM_BUNDLE_SHA256.tar.gz"
test -f "$bundle_archive" && test ! -L "$bundle_archive"
test -d "$PBM_SOURCE_DIR" && test ! -L "$PBM_SOURCE_DIR"
test -f "$PBM_BUNDLE_MANIFEST" && test ! -L "$PBM_BUNDLE_MANIFEST"
test "$NSLOTS" = 4
test "$(sha256sum "$bundle_archive" | awk '{print $1}')" = \
  "$PBM_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$PBM_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$PBM_SOURCE_COMMIT"
cmp -s "$PBM_BUNDLE_MANIFEST" "$PBM_SOURCE_DIR/BUNDLE_FILES.sha256"

run_dir="$PBM_ROOT/runs/$PBM_RUN_ID"
output_dir="$run_dir/dense_oracle"
test -d "$run_dir" && test ! -e "$output_dir"
mkdir -p "$output_dir"
wrapper_complete=0
failure_stage=source_identity
failure() {
  rc=$?
  if (( wrapper_complete == 0 )); then
    printf 'PREP_BND1_DENSE_ORACLE_WRAPPER_FAILURE stage=%s rc=%s\n' \
      "$failure_stage" "$rc" > "$output_dir/wrapper.fail"
  fi
  exit "$rc"
}
trap failure EXIT

(cd "$PBM_SOURCE_DIR" && sha256sum -c BUNDLE_FILES.sha256) \
  > "$output_dir/source_manifest.check"
bundle_manifest_sha=$(sha256sum "$PBM_BUNDLE_MANIFEST" | awk '{print $1}')
matlab_oracle_rel=varcomp_kss/benchmarks/oracle/varcomp_kss_dense_oracle.m
stata_oracle_rel=varcomp_kss/benchmarks/oracle/stata_oracle.do
wrapper_rel=varcomp_kss/benchmarks/prep_bnd1_matlab/run_dense_oracle.sge
validator_rel=varcomp_kss/benchmarks/prep_bnd1_matlab/validate_dense_oracle_scc.py
{
  printf 'key\tvalue\n'
  printf 'schema\tPREP-BND-1-DENSE-ORACLE-SOURCE-V1\n'
  printf 'source_commit\t%s\n' "$PBM_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$PBM_BUNDLE_SHA256"
  printf 'bundle_archive_sha256\t%s\n' \
    "$(sha256sum "$bundle_archive" | awk '{print $1}')"
  printf 'bundle_manifest_sha256\t%s\n' "$bundle_manifest_sha"
  printf 'internal_manifest_sha256\t%s\n' \
    "$(sha256sum "$PBM_SOURCE_DIR/BUNDLE_FILES.sha256" | awk '{print $1}')"
  printf 'matlab_oracle_sha256\t%s\n' \
    "$(sha256sum "$PBM_SOURCE_DIR/$matlab_oracle_rel" | awk '{print $1}')"
  printf 'stata_oracle_sha256\t%s\n' \
    "$(sha256sum "$PBM_SOURCE_DIR/$stata_oracle_rel" | awk '{print $1}')"
  printf 'wrapper_sha256\t%s\n' \
    "$(sha256sum "$PBM_SOURCE_DIR/$wrapper_rel" | awk '{print $1}')"
  printf 'post_validator_sha256\t%s\n' \
    "$(sha256sum "$PBM_SOURCE_DIR/$validator_rel" | awk '{print $1}')"
} > "$output_dir/source_receipt.tsv"

scratch="$TMPDIR/prep-bnd1-dense-oracle-$JOB_ID"
case "$scratch" in "$TMPDIR"/*) ;; *) exit 198 ;; esac
test ! -e "$scratch"
mkdir -p "$scratch/oracle" "$scratch/stata"
chmod 700 "$scratch" "$scratch/oracle" "$scratch/stata"

failure_stage=matlab_application
module purge
module load matlab/2025b
/usr/bin/time -v -o "$output_dir/matlab.resources.txt" \
  /usr/bin/timeout --signal=TERM --kill-after=30 600 \
  matlab -batch \
    "addpath('$PBM_SOURCE_DIR/varcomp_kss/benchmarks/oracle'); varcomp_kss_dense_oracle('$scratch/oracle','$PBM_SOURCE_COMMIT');" \
    > "$output_dir/matlab.application.txt" 2>&1
grep -F "VARCOMP_KSS MATLAB ORACLE PASS: $PBM_SOURCE_COMMIT" \
  "$output_dir/matlab.application.txt"
test -s "$scratch/oracle/matlab_oracle.csv"

failure_stage=stata_application
module purge
module load stata-mp/19
export STATATMP="$scratch/stata"
(cd "$PBM_SOURCE_DIR" && \
  /usr/bin/time -v -o "$output_dir/stata.resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=30 600 \
    stata-mp -q do "$PBM_SOURCE_DIR/$stata_oracle_rel" \
      "$scratch/oracle" "$PBM_SOURCE_COMMIT") \
  > "$output_dir/stata.application.txt" 2>&1
grep -F "VARCOMP_KSS STATA/MATLAB ORACLE PASS" \
  "$output_dir/stata.application.txt"
test -s "$scratch/oracle/stata_oracle.csv"
cp "$scratch/oracle/matlab_oracle.csv" "$output_dir/matlab_oracle.csv"
cp "$scratch/oracle/stata_oracle.csv" "$output_dir/stata_oracle.csv"

failure_stage=dense_oracle_validation
module purge
module load python3/3.12.4
export PYTHONDONTWRITEBYTECODE=1
python3 \
  "$PBM_SOURCE_DIR/varcomp_kss/benchmarks/prep_bnd1_matlab/validate_dense_oracle.py" \
  --matlab "$output_dir/matlab_oracle.csv" \
  --stata "$output_dir/stata_oracle.csv" \
  --source-commit "$PBM_SOURCE_COMMIT" \
  --output "$output_dir/dense_oracle_validation.json" \
  > "$output_dir/dense_oracle_validation.application.txt" 2>&1
grep -F "PREP_BND1_DENSE_ORACLE_PASS $PBM_SOURCE_COMMIT" \
  "$output_dir/dense_oracle_validation.application.txt"

failure_stage=receipts
{
  printf 'artifact\tsha256\n'
  for artifact in dense_oracle_validation.application.txt \
    dense_oracle_validation.json matlab.application.txt matlab_oracle.csv \
    source_manifest.check source_receipt.tsv stata.application.txt \
    stata_oracle.csv; do
    printf '%s\t%s\n' "$artifact" \
      "$(sha256sum "$output_dir/$artifact" | awk '{print $1}')"
  done
} > "$output_dir/application_files.sha256.tsv"
application_manifest_sha=$(sha256sum \
  "$output_dir/application_files.sha256.tsv" | awk '{print $1}')
{
  printf 'key\tvalue\n'
  printf 'schema\tPREP-BND-1-DENSE-ORACLE-NODE-V1\n'
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$PBM_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$PBM_BUNDLE_SHA256"
  printf 'bundle_manifest_sha256\t%s\n' "$bundle_manifest_sha"
  printf 'application_manifest_sha256\t%s\n' "$application_manifest_sha"
  printf 'requested_slots\t4\n'
  printf 'actual_slots\t%s\n' "$NSLOTS"
  printf 'matlab_module\tmatlab/2025b\n'
  printf 'stata_module\tstata-mp/19\n'
} > "$output_dir/node_receipt.tsv"
printf 'PREP_BND1_DENSE_ORACLE_SCC_PASS %s %s\n' \
  "$PBM_SOURCE_COMMIT" "$PBM_BUNDLE_SHA256" > "$output_dir/oracle.pass"
wrapper_complete=1
failure_stage=complete
trap - EXIT
printf 'PREP-BND-1 DENSE ORACLE SCC PASS: %s\n' "$PBM_SOURCE_COMMIT"
