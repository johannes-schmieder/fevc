#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 14
#$ -l h_rt=12:00:00
#$ -l mem_per_core=4G
#$ -N kms_prepare
#$ -m a

# Non-submitting scalar execution wrapper. submit_matlab_scale.sh replaces
# the 12-hour ceiling with an explicit measured application timeout plus a
# ten-minute wrapper reserve.

set -Eeuo pipefail

failure_stage=bootstrap
wrapper_started_ns=$(date +%s%N)
staging_seconds=0
module_seconds=0
promotion_seconds=0
receipt_written=0
python_bin=

write_receipt() {
  local process_status=$1
  local receipt_builder=\
"${KSS_MS_SOURCE_DIR:-}/kss_bc/benchmarks/matlab_scale/build_prepare_receipt.py"
  local receipt="${KSS_MS_PREP_JOB_DIR:-}/wrapper.json"
  if [[ -z "$python_bin" ]]; then
    python_bin=$(command -v python3 || true)
  fi
  if [[ -z "$python_bin" || ! -f "$receipt_builder" || \
        -z "${KSS_MS_PREP_JOB_DIR:-}" ]]; then
    if [[ -n "${KSS_MS_PREP_JOB_DIR:-}" ]]; then
      printf 'KSS MATLAB SCALE PREPARATION RECEIPT UNAVAILABLE stage=%s status=%s\n' \
        "$failure_stage" "$process_status" \
        > "$KSS_MS_PREP_JOB_DIR/receipt.failure.txt"
    fi
    return 2
  fi
  "$python_bin" "$receipt_builder" \
    --label "${KSS_MS_LABEL:-UNKNOWN}" \
    --scale "${KSS_MS_SCALE:-0}" \
    --topology "${KSS_MS_TOPOLOGY:-UNKNOWN}" \
    --source-commit "${KSS_MS_SOURCE_COMMIT:-UNKNOWN}" \
    --bundle-sha256 "${KSS_MS_BUNDLE_SHA256:-UNKNOWN}" \
    --source-input-sha256 "${KSS_MS_SOURCE_INPUT_SHA256:-UNKNOWN}" \
    --prepared-input-sha256 "${prepared_sha:-UNKNOWN}" \
    --retained-key-sha256 "${retained_key_sha:-UNKNOWN}" \
    --failure-stage "$failure_stage" --exit-status "$process_status" \
    --job-id "${JOB_ID:-}" --hostname "${HOSTNAME:-}" \
    --sge-task-id "${SGE_TASK_ID:-undefined}" \
    --requested-slots "${KSS_MS_REQUESTED_SLOTS:-0}" \
    --actual-slots "${NSLOTS:-0}" \
    --mem-per-core-gib "${KSS_MS_MEM_PER_CORE_GIB:-0}" \
    --stata-processors "${KSS_MS_STATA_PROCESSORS:-0}" \
    --timeout-seconds "${KSS_MS_TIMEOUT_SECONDS:-0}" \
    --timeout-basis "${KSS_MS_TIMEOUT_BASIS:-UNKNOWN}" \
    --scheduler-hard-wall-seconds \
      "${KSS_MS_SCHEDULER_HARD_WALL_SECONDS:-0}" \
    --started-epoch-ns "$wrapper_started_ns" \
    --finished-epoch-ns "$(date +%s%N)" \
    --staging-seconds "$staging_seconds" \
    --module-seconds "$module_seconds" \
    --promotion-seconds "$promotion_seconds" \
    --time-report "${KSS_MS_PREP_JOB_DIR}/resources.txt" \
    --application-log "${KSS_MS_PREP_JOB_DIR}/application.txt" \
    --input-csv "${KSS_MS_PREP_JOB_DIR}/input.csv" \
    --retained-keys "${KSS_MS_PREP_JOB_DIR}/retained_keys.canonical.txt" \
    --summary "${KSS_MS_PREP_JOB_DIR}/prepare.csv" \
    --pass-marker "${KSS_MS_PREP_JOB_DIR}/prepare.stata.pass" \
    --output "$receipt"
}

finalize_receipt() {
  local original_status=$?
  trap - EXIT
  if (( receipt_written == 0 )); then
    write_receipt "$original_status" || {
      local receipt_status=$?
      printf 'KSS MATLAB SCALE PREPARATION RECEIPT FAILURE stage=%s original_status=%s receipt_status=%s\n' \
        "$failure_stage" "$original_status" "$receipt_status" \
        > "${KSS_MS_PREP_JOB_DIR:-/tmp}/receipt.failure.txt"
      if (( original_status == 0 )); then
        original_status=$receipt_status
      fi
    }
  fi
  exit "$original_status"
}
trap finalize_receipt EXIT

require_env() {
  local name=$1
  [[ -n "${!name:-}" ]] || {
    printf 'missing required environment variable: %s\n' "$name" >&2
    return 198
  }
}

for name in KSS_MS_RUN_DIR KSS_MS_PREP_JOB_DIR KSS_MS_SOURCE_DIR \
  KSS_MS_SOURCE_COMMIT KSS_MS_BUNDLE_SHA256 KSS_MS_LABEL KSS_MS_SCALE \
  KSS_MS_TOPOLOGY KSS_MS_SOURCE_INPUT_DTA KSS_MS_SOURCE_INPUT_SHA256 \
  KSS_MS_TIMEOUT_SECONDS KSS_MS_TIMEOUT_BASIS \
  KSS_MS_SCHEDULER_HARD_WALL_SECONDS KSS_MS_REQUESTED_SLOTS \
  KSS_MS_MEM_PER_CORE_GIB KSS_MS_STATA_PROCESSORS TMPDIR; do
  require_env "$name"
done

failure_stage=environment
[[ "$KSS_MS_LABEL" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$KSS_MS_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$KSS_MS_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_MS_SOURCE_INPUT_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "${JOB_ID:-}" =~ ^[0-9]+$ ]]
case "${SGE_TASK_ID:-undefined}" in
  undefined|"") ;;
  *)
    printf 'array tasks are prohibited: SGE_TASK_ID=%s\n' "$SGE_TASK_ID" >&2
    exit 198
    ;;
esac
[[ "$KSS_MS_SCALE" =~ ^(1|2|4)$ ]]
[[ "$KSS_MS_TOPOLOGY" =~ ^(well|well_connected|ring)$ ]]
if [[ "$KSS_MS_SCALE" == 1 ]]; then
  [[ "$KSS_MS_TOPOLOGY" == well ]]
elif [[ "$KSS_MS_SCALE" == 2 ]]; then
  [[ "$KSS_MS_TOPOLOGY" == well_connected || "$KSS_MS_TOPOLOGY" == ring ]]
else
  [[ "$KSS_MS_SCALE" == 4 && "$KSS_MS_TOPOLOGY" == well_connected ]]
fi
[[ "$KSS_MS_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]
(( KSS_MS_TIMEOUT_SECONDS >= 300 && KSS_MS_TIMEOUT_SECONDS <= 42600 ))
[[ "$KSS_MS_TIMEOUT_BASIS" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$KSS_MS_SCHEDULER_HARD_WALL_SECONDS" =~ ^[1-9][0-9]*$ ]]
(( KSS_MS_SCHEDULER_HARD_WALL_SECONDS == KSS_MS_TIMEOUT_SECONDS + 600 ))
(( KSS_MS_SCHEDULER_HARD_WALL_SECONDS <= 43200 ))
[[ "$KSS_MS_REQUESTED_SLOTS" == 14 ]]
[[ "${NSLOTS:-}" == "$KSS_MS_REQUESTED_SLOTS" ]]
[[ "$KSS_MS_MEM_PER_CORE_GIB" == 4 ]]
[[ "$KSS_MS_STATA_PROCESSORS" == 4 ]]
case "$KSS_MS_RUN_DIR" in /projectnb/welfgr/kss-bc/runs/*) ;; *) exit 198 ;; esac
case "$KSS_MS_PREP_JOB_DIR" in
  "$KSS_MS_RUN_DIR/matlab_scale/$KSS_MS_LABEL/prepare") ;;
  *) exit 198 ;;
esac
case "$KSS_MS_SOURCE_DIR" in
  "/projectnb/welfgr/kss-bc/bundles/$KSS_MS_BUNDLE_SHA256/source") ;;
  *) exit 198 ;;
esac
case "$KSS_MS_SOURCE_INPUT_DTA" in /projectnb/welfgr/*) ;; *) exit 198 ;; esac
[[ "$KSS_MS_SOURCE_INPUT_DTA" =~ ^/projectnb/welfgr/[A-Za-z0-9._/-]+$ ]]
test -d "$KSS_MS_PREP_JOB_DIR"
test ! -e "$KSS_MS_PREP_JOB_DIR/wrapper.json"
test ! -e "$KSS_MS_PREP_JOB_DIR/wrapper.pass"
test -f "$KSS_MS_SOURCE_INPUT_DTA"
test "$(tr -d '[:space:]' < "$KSS_MS_RUN_DIR/source_commit.txt")" = \
  "$KSS_MS_SOURCE_COMMIT"
test "$(tr -d '[:space:]' < "$KSS_MS_RUN_DIR/bundle.sha256")" = \
  "$KSS_MS_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$KSS_MS_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$KSS_MS_SOURCE_COMMIT"
bundle_dir=${KSS_MS_SOURCE_DIR%/source}
bundle_archive="$bundle_dir/$KSS_MS_BUNDLE_SHA256.tar.gz"
bundle_manifest="$bundle_dir/$KSS_MS_BUNDLE_SHA256.files.sha256"
test "$(sha256sum "$bundle_archive" | awk '{print $1}')" = \
  "$KSS_MS_BUNDLE_SHA256"
(cd "$KSS_MS_SOURCE_DIR" && sha256sum -c "$bundle_manifest")
test "$(sha256sum "$KSS_MS_SOURCE_INPUT_DTA" | awk '{print $1}')" = \
  "$KSS_MS_SOURCE_INPUT_SHA256"

failure_stage=module_setup
module_started_ns=$(date +%s%N)
module purge
module load python3/3.12.4
module load stata-mp/19
python_bin=$(command -v python3)
command -v stata-mp >/dev/null
module_finished_ns=$(date +%s%N)
module_seconds=$(awk -v a="$module_started_ns" -v b="$module_finished_ns" \
  'BEGIN { printf "%.9f", (b-a)/1000000000 }')

failure_stage=node_local_staging
scratch="$TMPDIR/kss-matlab-scale-${JOB_ID:-local}-prepare"
case "$scratch" in "$TMPDIR"/*) ;; *) exit 198 ;; esac
test ! -e "$scratch"
mkdir -p "$scratch/input" "$scratch/output" "$scratch/statatmp"
chmod 700 "$scratch" "$scratch/input" "$scratch/output" "$scratch/statatmp"
stage_started_ns=$(date +%s%N)
cp "$KSS_MS_SOURCE_INPUT_DTA" "$scratch/input/retained_base.dta"
test "$(sha256sum "$scratch/input/retained_base.dta" | awk '{print $1}')" = \
  "$KSS_MS_SOURCE_INPUT_SHA256"
stage_finished_ns=$(date +%s%N)
staging_seconds=$(awk -v a="$stage_started_ns" -v b="$stage_finished_ns" \
  'BEGIN { printf "%.9f", (b-a)/1000000000 }')

export OMP_NUM_THREADS="$KSS_MS_STATA_PROCESSORS"
export STATATMP="$scratch/statatmp"
failure_stage=stata_preparation
set +e
/usr/bin/time -v -o "$KSS_MS_PREP_JOB_DIR/resources.txt" \
  /usr/bin/timeout --signal=TERM --kill-after=60 \
  "$KSS_MS_TIMEOUT_SECONDS" stata-mp -q do \
    "$KSS_MS_SOURCE_DIR/kss_bc/benchmarks/matlab_scale/prepare_fixed_sample.do" \
    "$KSS_MS_SOURCE_DIR" "$KSS_MS_LABEL" \
    "$scratch/input/retained_base.dta" "$KSS_MS_SOURCE_INPUT_SHA256" \
    "$KSS_MS_SCALE" "$KSS_MS_TOPOLOGY" "$scratch/output" \
    "$KSS_MS_SOURCE_COMMIT" "$KSS_MS_BUNDLE_SHA256" \
    "$KSS_MS_REQUESTED_SLOTS" "${NSLOTS:-}" "$KSS_MS_STATA_PROCESSORS" \
    > "$KSS_MS_PREP_JOB_DIR/application.txt" 2>&1
stata_status=$?
set -e
if (( stata_status != 0 )); then
  exit "$stata_status"
fi

failure_stage=output_acceptance
grep -F "KSS MATLAB SCALE PREPARE PASS: $KSS_MS_LABEL" \
  "$KSS_MS_PREP_JOB_DIR/application.txt"
promotion_started_ns=$(date +%s%N)
for artifact in input.csv retained_keys.canonical.txt prepare.csv \
  prepare.stata.pass; do
  test -s "$scratch/output/$artifact"
  cp "$scratch/output/$artifact" "$KSS_MS_PREP_JOB_DIR/$artifact.tmp"
  chmod 600 "$KSS_MS_PREP_JOB_DIR/$artifact.tmp"
  mv "$KSS_MS_PREP_JOB_DIR/$artifact.tmp" \
    "$KSS_MS_PREP_JOB_DIR/$artifact"
done
prepared_source_sha=$(sha256sum "$scratch/output/input.csv" | awk '{print $1}')
prepared_sha=$(sha256sum "$KSS_MS_PREP_JOB_DIR/input.csv" | awk '{print $1}')
test "$prepared_sha" = "$prepared_source_sha"
retained_key_source_sha=$(
  sha256sum "$scratch/output/retained_keys.canonical.txt" | awk '{print $1}'
)
retained_key_sha=$(
  sha256sum "$KSS_MS_PREP_JOB_DIR/retained_keys.canonical.txt" | awk '{print $1}'
)
test "$retained_key_sha" = "$retained_key_source_sha"
printf '%s\n' "$prepared_sha" > "$KSS_MS_PREP_JOB_DIR/input.csv.sha256"
printf '%s\n' "$retained_key_sha" > \
  "$KSS_MS_PREP_JOB_DIR/retained_keys.sha256"
chmod 600 "$KSS_MS_PREP_JOB_DIR/input.csv.sha256" \
  "$KSS_MS_PREP_JOB_DIR/retained_keys.sha256"
promotion_finished_ns=$(date +%s%N)
promotion_seconds=$(awk -v a="$promotion_started_ns" -v b="$promotion_finished_ns" \
  'BEGIN { printf "%.9f", (b-a)/1000000000 }')
test "$(sha256sum "$KSS_MS_SOURCE_INPUT_DTA" | awk '{print $1}')" = \
  "$KSS_MS_SOURCE_INPUT_SHA256"
(cd "$KSS_MS_SOURCE_DIR" && sha256sum -c "$bundle_manifest")

failure_stage=complete
printf 'KSS_MATLAB_SCALE_PREPARE_WRAPPER_PASS %s %s %s %s %s\n' \
  "$KSS_MS_LABEL" "$KSS_MS_SOURCE_COMMIT" "$KSS_MS_BUNDLE_SHA256" \
  "$prepared_sha" "$retained_key_sha" \
  > "$KSS_MS_PREP_JOB_DIR/wrapper.pass"
chmod 600 "$KSS_MS_PREP_JOB_DIR/wrapper.pass"
set +e
write_receipt 0
receipt_status=$?
set -e
if (( receipt_status != 0 )); then
  if [[ -f "$KSS_MS_PREP_JOB_DIR/wrapper.json" ]]; then
    receipt_written=1
  fi
  exit "$receipt_status"
fi
receipt_written=1
grep -F '"status": "PASS"' "$KSS_MS_PREP_JOB_DIR/wrapper.json"
printf 'KSS MATLAB SCALE PREPARATION WRAPPER PASS: %s\n' "$KSS_MS_LABEL"
