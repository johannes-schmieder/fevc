#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N kss_numopt2

set -euo pipefail
for name in KSS_RUN_DIR KSS_SOURCE_DIR KSS_SOURCE_COMMIT \
  KSS_BUNDLE_SHA256 KSS_EXPERIMENT_ID KSS_TASK_SHA256 KSS_WORKERS \
  KSS_FIRMS KSS_CELLS_PER_WORKER KSS_ROWS_PER_CELL KSS_CONNECTIVITY \
  KSS_PROBES KSS_SEED KSS_BATCH KSS_REQUESTED_SLOTS \
  KSS_STATA_PROCESSORS KSS_MEM_PER_CORE_GIB KSS_MEMORY_GIB \
  KSS_HARD_WALL_SECONDS KSS_OUTPUT_DIR TMPDIR JOB_ID HOSTNAME; do
  test -n "${!name:-}" || { printf '%s\n' "missing $name" >&2; exit 198; }
done

[[ "$KSS_RUN_DIR" == /projectnb/welfgr/kss-bc/runs/* ]]
[[ "$KSS_SOURCE_DIR" == /projectnb/welfgr/kss-bc/bundles/*/source ]]
[[ "$KSS_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]
[[ "$KSS_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_TASK_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_EXPERIMENT_ID" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$KSS_CONNECTIVITY" =~ ^(strong|weak)$ ]]
[[ "$KSS_WORKERS" =~ ^[0-9]+$ ]]
[[ "$KSS_FIRMS" =~ ^[0-9]+$ ]]
(( KSS_WORKERS == 40 * KSS_FIRMS ))
[[ "$KSS_CELLS_PER_WORKER" =~ ^[2-7]$ ]]
[[ "$KSS_ROWS_PER_CELL" =~ ^(1|8)$ ]]
[[ "$KSS_PROBES" =~ ^[0-9]+$ ]] && (( KSS_PROBES >= 2 ))
[[ "$KSS_SEED" =~ ^[0-9]+$ ]] && (( KSS_SEED <= 2147483646 ))
[[ "$KSS_BATCH" == auto || "$KSS_BATCH" =~ ^[1-9][0-9]*$ ]]
[[ "$KSS_REQUESTED_SLOTS" =~ ^[0-9]+$ ]] && (( KSS_REQUESTED_SLOTS >= 1 ))
test "${NSLOTS:-}" = "$KSS_REQUESTED_SLOTS"
[[ "$KSS_STATA_PROCESSORS" =~ ^[0-9]+$ ]]
(( KSS_STATA_PROCESSORS >= 1 && KSS_STATA_PROCESSORS <= KSS_REQUESTED_SLOTS ))
[[ "$KSS_MEM_PER_CORE_GIB" =~ ^[0-9]+$ ]]
test "$KSS_MEMORY_GIB" = "$(( KSS_REQUESTED_SLOTS * KSS_MEM_PER_CORE_GIB ))"
[[ "$KSS_HARD_WALL_SECONDS" =~ ^[0-9]+$ ]]
(( KSS_HARD_WALL_SECONDS >= 600 ))
test "$KSS_OUTPUT_DIR" = "$KSS_RUN_DIR/experiments/$KSS_EXPERIMENT_ID"
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = \
  "$KSS_SOURCE_COMMIT"
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/bundle.sha256")" = \
  "$KSS_BUNDLE_SHA256"
test "$(tr -d '[:space:]' < "$KSS_SOURCE_DIR/SOURCE_COMMIT.txt")" = \
  "$KSS_SOURCE_COMMIT"
(cd "$KSS_SOURCE_DIR" && sha256sum -c BUNDLE_FILES.sha256)
test "$(sha256sum "$KSS_OUTPUT_DIR/task.tsv" | awk '{print $1}')" = \
  "$KSS_TASK_SHA256"

wrapper_complete=0
wrapper_failure() {
  local rc=$?
  if (( wrapper_complete == 0 )); then
    printf '%s\n' "KSS_NUMOPT2_WRAPPER_FAILURE $KSS_EXPERIMENT_ID rc=$rc" \
      > "$KSS_OUTPUT_DIR/wrapper.fail"
  fi
  exit "$rc"
}
trap wrapper_failure EXIT

module purge
module load stata-mp/19
command -v stata-mp >/dev/null
export OMP_NUM_THREADS="$KSS_STATA_PROCESSORS"
export STATATMP="$TMPDIR/kss-numopt2-$JOB_ID"
mkdir -p "$STATATMP"
cd "$KSS_SOURCE_DIR"

input_dta="$STATATMP/input.dta"
/usr/bin/time -v -o "$KSS_OUTPUT_DIR/generation_resources.txt" \
  stata-mp -q do kss_bc/benchmarks/scc/numopt2_generate.do \
    "$KSS_EXPERIMENT_ID" "$KSS_WORKERS" "$KSS_FIRMS" \
    "$KSS_CELLS_PER_WORKER" "$KSS_ROWS_PER_CELL" "$KSS_CONNECTIVITY" \
    "$input_dta" "$KSS_OUTPUT_DIR/input_receipt.tsv" \
  > "$KSS_OUTPUT_DIR/generation.log" 2>&1
grep -F "KSS_NUMOPT2_INPUT_PASS $KSS_EXPERIMENT_ID" \
  "$KSS_OUTPUT_DIR/generation.log"
input_sha=$(sha256sum "$input_dta" | awk '{print $1}')
printf '%s\n' "$input_sha" > "$KSS_OUTPUT_DIR/input.sha256"

wrapper_reserve_seconds=180
application_timeout=$(( KSS_HARD_WALL_SECONDS - wrapper_reserve_seconds ))
/usr/bin/time -v -o "$KSS_OUTPUT_DIR/process_resources.txt" \
  /usr/bin/timeout --signal=TERM "$application_timeout" \
  stata-mp -q do kss_bc/benchmarks/scc/kss_scale_driver.do \
    "$KSS_EXPERIMENT_ID" "$input_dta" "$input_sha" \
    "$KSS_BUNDLE_SHA256" "$KSS_SOURCE_COMMIT" local 1 \
    "$KSS_PROBES" "$KSS_SEED" "$KSS_BATCH" "$KSS_MEMORY_GIB" \
    "$KSS_REQUESTED_SLOTS" "${NSLOTS:-}" "$KSS_STATA_PROCESSORS" \
    frequency target_weight deletion_unit "$KSS_OUTPUT_DIR" \
    "$application_timeout" \
  > "$KSS_OUTPUT_DIR/application.log" 2>&1
grep -F "KSS-STREAMLINE ESTIMATOR PASS: $KSS_EXPERIMENT_ID" \
  "$KSS_OUTPUT_DIR/application.log"
test -s "$KSS_OUTPUT_DIR/summary.csv"
test -s "$KSS_OUTPUT_DIR/rhs.csv"
test -s "$KSS_OUTPUT_DIR/stata.pass"

{
  printf 'key\tvalue\n'
  printf 'receipt_version\tKSS-NUMOPT-2-NODE-V1\n'
  printf 'experiment_id\t%s\n' "$KSS_EXPERIMENT_ID"
  printf 'job_id\t%s\n' "$JOB_ID"
  printf 'hostname\t%s\n' "$HOSTNAME"
  printf 'source_commit\t%s\n' "$KSS_SOURCE_COMMIT"
  printf 'bundle_sha256\t%s\n' "$KSS_BUNDLE_SHA256"
  printf 'task_sha256\t%s\n' "$KSS_TASK_SHA256"
  printf 'input_sha256\t%s\n' "$input_sha"
  printf 'requested_slots\t%s\n' "$KSS_REQUESTED_SLOTS"
  printf 'actual_slots\t%s\n' "${NSLOTS:-}"
  printf 'stata_processors\t%s\n' "$KSS_STATA_PROCESSORS"
  printf 'memory_gib\t%s\n' "$KSS_MEMORY_GIB"
  printf 'hard_wall_seconds\t%s\n' "$KSS_HARD_WALL_SECONDS"
} > "$KSS_OUTPUT_DIR/node_receipt.tsv"

printf '%s\n' \
  "KSS_NUMOPT2_WRAPPER_PASS $KSS_EXPERIMENT_ID $KSS_SOURCE_COMMIT $KSS_TASK_SHA256 $input_sha" \
  > "$KSS_OUTPUT_DIR/wrapper.pass"
wrapper_complete=1
trap - EXIT
printf '%s\n' "KSS-NUMOPT-2 SCC PASS: $KSS_EXPERIMENT_ID"
