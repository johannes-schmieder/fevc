#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 4
#$ -l h_rt=02:00:00
#$ -l mem_per_core=4G
#$ -N kss_port

set -euo pipefail
: "${KSS_RUN_DIR:?KSS_RUN_DIR is required}"
: "${KSS_SOURCE_DIR:?KSS_SOURCE_DIR is required}"
: "${KSS_SOURCE_COMMIT:?KSS_SOURCE_COMMIT is required}"

test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$KSS_SOURCE_COMMIT"
module purge
module load stata-mp/19

job_dir="$KSS_RUN_DIR/portability"
mkdir -p "$job_dir/install"
cd "$KSS_SOURCE_DIR"

/usr/bin/time -v -o "$job_dir/full_suite.resources.txt" \
  stata-mp -q do "$KSS_SOURCE_DIR/kss_bc/tests/stata/run_all.do" full \
  > "$job_dir/full_suite.application.txt" 2>&1
grep -F "KSS_BC TEST SUITE PASS: full" "$job_dir/full_suite.application.txt"

/usr/bin/time -v -o "$job_dir/install.resources.txt" \
  stata-mp -q do "$KSS_SOURCE_DIR/kss_bc/tests/stata/test_install.do" \
  "$KSS_SOURCE_DIR/kss_bc" "$job_dir/install" \
  > "$job_dir/install.application.txt" 2>&1
grep -F "KSS_BC INSTALL TEST PASS" "$job_dir/install.application.txt"

printf '%s\n' "KSS_BC_PORTABILITY_PASS $KSS_SOURCE_COMMIT" \
  > "$job_dir/portability.pass"
printf '%s\n' "KSS_BC SCC PORTABILITY PASS"
