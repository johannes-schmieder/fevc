#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -m a
#$ -N kss_prod

set -euo pipefail
: "${KSS_RUN_DIR:?}"
: "${KSS_BUNDLE_DIR:?}"
: "${KSS_BUNDLE_SHA256:?}"
: "${KSS_DATA_MANIFEST_SHA256:?}"
: "${KSS_EXPERIMENT_ID:?}"
: "${KSS_STAGE:?}"
: "${KSS_DATASET:?}"
: "${KSS_STATA_VERSION:?}"
: "${KSS_PROCESSORS:?}"
: "${KSS_MEMORY_GIB:?}"
: "${KSS_PROBES:?}"
: "${KSS_BATCH:?}"
: "${KSS_PRECONDITIONER:?}"
: "${KSS_TEMPERATURE:?}"
: "${KSS_REPETITIONS:?}"
: "${KSS_TIMEOUT_SECONDS:?}"
: "${KSS_DEPENDENCY_EXPERIMENTS:?}"

[[ "$KSS_BUNDLE_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_DATA_MANIFEST_SHA256" =~ ^[0-9a-f]{64}$ ]]
[[ "$KSS_EXPERIMENT_ID" =~ ^[A-Za-z0-9._-]+$ ]]
[[ "$KSS_STAGE" =~ ^(bundle_smoke|install_auto|install_cmg|license|hierarchy_stress|selector|prepare|fixed|sample_compare|cz18_preflight|calibration|calibration_selector|full|stress2x)$ ]]
[[ "$KSS_PROCESSORS" =~ ^(4|8)$ ]]
[[ "$KSS_MEMORY_GIB" =~ ^([1-9]|[1-4][0-9]|5[0-6])$ ]]
[[ "$KSS_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]]
if [[ "$KSS_STAGE" == stress2x ]]; then
  (( KSS_TIMEOUT_SECONDS >= 60 && KSS_TIMEOUT_SECONDS <= 10800 ))
else
  (( KSS_TIMEOUT_SECONDS >= 60 && KSS_TIMEOUT_SECONDS <= 5400 ))
fi

bundle_archive="$KSS_BUNDLE_DIR/$KSS_BUNDLE_SHA256.tar.gz"
source_dir="$KSS_BUNDLE_DIR/source"
source_commit=$(tr -d '[:space:]' < "$source_dir/SOURCE_COMMIT.txt")
[[ "$source_commit" =~ ^[0-9a-f]{40}$ ]]
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$source_commit"
test "$(sha256sum "$bundle_archive" | awk '{print $1}')" = "$KSS_BUNDLE_SHA256"
(
  cd "$source_dir"
  sha256sum -c "$KSS_BUNDLE_DIR/$KSS_BUNDLE_SHA256.files.sha256"
)
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/bundle.sha256")" = "$KSS_BUNDLE_SHA256"
frozen_manifest="$KSS_RUN_DIR/input/data_manifest.tsv"
test "$(sha256sum "$frozen_manifest" | awk '{print $1}')" = "$KSS_DATA_MANIFEST_SHA256"
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/input/data_manifest.sha256")" = \
  "$KSS_DATA_MANIFEST_SHA256"

collect_dependency_qacct() {
  local dependency=$1 job_id report temporary attempt
  job_id=$(tr -d '[:space:]' < "$KSS_RUN_DIR/submissions/$dependency.job_id")
  [[ "$job_id" =~ ^[0-9]+([.][0-9:-]+)?$ ]]
  report="$KSS_RUN_DIR/qacct/$dependency.txt"
  temporary="$report.tmp.$$"
  for attempt in $(seq 1 60); do
    if qacct -j "$job_id" > "$temporary" 2>&1 && \
       awk '$1=="failed" {failed=$2} $1=="exit_status" {exit_status=$2}
            END {exit !(failed==0 && exit_status==0)}' "$temporary"; then
      mv "$temporary" "$report"
      return 0
    fi
    sleep 10
  done
  printf '%s\n' "dependency qacct unavailable or unsuccessful: $dependency" >&2
  return 1
}

if [[ "$KSS_DEPENDENCY_EXPERIMENTS" != - ]]; then
  IFS=: read -ra dependency_names <<< "$KSS_DEPENDENCY_EXPERIMENTS"
  for dependency in "${dependency_names[@]}"; do
    [[ "$dependency" =~ ^[A-Za-z0-9._-]+$ ]]
    dependency_pass="$KSS_RUN_DIR/experiments/$dependency/wrapper.pass"
    test -s "$dependency_pass"
    grep -Fx "KSS_PROD_WRAPPER_PASS $dependency $KSS_BUNDLE_SHA256 $source_commit $KSS_DATA_MANIFEST_SHA256" \
      "$dependency_pass"
    collect_dependency_qacct "$dependency"
  done
fi

output_dir="$KSS_RUN_DIR/experiments/$KSS_EXPERIMENT_ID"
mkdir -p "$output_dir"

# A full 200-probe larger-than-CZ18 stress run starts only when its preceding
# 20-probe run is source/input/route/residual bound and projects inside the
# explicitly bounded stress timeout. No estimator semantics change.
if [[ "$KSS_STAGE" == stress2x && "$KSS_PROBES" == 200 ]]; then
  stress_calibration="$KSS_RUN_DIR/experiments/cz18_stress2x_cal20/prod_cz18_stress2x_cal20.csv"
  test -s "$stress_calibration"
  module purge
  module load miniconda/25.3.1
  python "$source_dir/kss_bc/benchmarks/scc/validate_stress_projection.py" \
    --calibration "$stress_calibration" \
    --retained-sha-file "$KSS_RUN_DIR/experiments/cz18_full200/retained_sample.sha256" \
    --bundle-sha "$KSS_BUNDLE_SHA256" --source-commit "$source_commit" \
    --manifest-sha "$KSS_DATA_MANIFEST_SHA256" \
    --timeout "$KSS_TIMEOUT_SECONDS" \
    --output "$output_dir/stress_projection.txt" \
    > "$output_dir/stress_projection.application.txt" 2>&1
  grep -F "KSS_PROD STRESS PROJECTION PASS" \
    "$output_dir/stress_projection.application.txt"
fi

printf '%s\n' \
  "experiment=$KSS_EXPERIMENT_ID stage=$KSS_STAGE bundle=$KSS_BUNDLE_SHA256 source=$source_commit manifest=$KSS_DATA_MANIFEST_SHA256 job=${JOB_ID:-} host=${HOSTNAME:-} slots=${NSLOTS:-}" \
  > "$output_dir/run.metadata.txt"

if [[ "$KSS_STAGE" == calibration ]]; then
  node_hostname=${HOSTNAME:?missing scheduler hostname}
  uname_machine=$(uname -m)
  cpu_model=$(lscpu | awk -F: '$1 ~ /^Model name[[:space:]]*$/ {
    sub(/^[[:space:]]+/, "", $2); print $2; exit
  }')
  logical_cpus=$(lscpu -p=CPU | awk '!/^#/ {count++} END {print count+0}')
  test -n "$uname_machine"
  test -n "$cpu_model"
  [[ "$logical_cpus" =~ ^[1-9][0-9]*$ ]]
  printf '%s\n' \
    'schema=kss_prod_node_v1' \
    "hostname=$node_hostname" \
    "uname_machine=$uname_machine" \
    "cpu_model=$cpu_model" \
    "logical_cpus=$logical_cpus" \
    > "$output_dir/node_characteristics.txt"
fi

write_wrapper_pass() {
  printf '%s\n' \
    "KSS_PROD_WRAPPER_PASS $KSS_EXPERIMENT_ID $KSS_BUNDLE_SHA256 $source_commit $KSS_DATA_MANIFEST_SHA256" \
    > "$output_dir/wrapper.pass"
}

if [[ "$KSS_STAGE" == hierarchy_stress ]]; then
  module purge
  module load "stata-mp/$KSS_STATA_VERSION"
  export OMP_NUM_THREADS="$KSS_PROCESSORS"
  export MKL_NUM_THREADS="$KSS_PROCESSORS"
  cd "$source_dir"
  /usr/bin/time -v -o "$output_dir/resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=60 "$KSS_TIMEOUT_SECONDS" \
    stata-mp -q do kss_bc/benchmarks/prod_hierarchy_stress.do \
    "$source_dir" "$output_dir/cmg_hierarchy.csv" "$KSS_PROCESSORS" \
    "$source_dir/shared/cmg/generated/cmg_test.mata" \
    > "$output_dir/application.txt" 2>&1
  test -s "$output_dir/cmg_hierarchy.csv"
  grep -F "CMG HIERARCHY SCALE STRESS PASS" "$output_dir/application.txt"
  write_wrapper_pass
  printf '%s\n' "KSS_PROD SCC HIERARCHY STRESS PASS: $KSS_EXPERIMENT_ID"
  exit 0
fi

prepared_dta=${KSS_PREPARED_DTA:--}
prepared_sha=-
wage_sha=${KSS_WAGE_INPUT_SHA256:--}
separations_commit=${KSS_SEPARATIONS_COMMIT:--}
if [[ "$KSS_DATASET" != synthetic ]]; then
  [[ "$wage_sha" =~ ^[0-9a-f]{64}$ ]]
  [[ "$separations_commit" =~ ^[0-9a-f]{40}$ ]]
fi

if [[ "$KSS_STAGE" == prepare ]]; then
  : "${KSS_WAGE_INPUT_DTA:?}"
  : "${KSS_SAMPLE_MODE:?}"
  : "${KSS_MAX_WORKERS:?}"
  test "$(sha256sum "$KSS_WAGE_INPUT_DTA" | awk '{print $1}')" = "$wage_sha"
  [[ "$KSS_SAMPLE_MODE" =~ ^(small|full)$ ]]
  [[ "$KSS_MAX_WORKERS" =~ ^[0-9]+$ ]]
  module purge
  module load "stata-mp/$KSS_STATA_VERSION"
  export OMP_NUM_THREADS="$KSS_PROCESSORS"
  export MKL_NUM_THREADS="$KSS_PROCESSORS"
  cd "$source_dir"
  /usr/bin/time -v -o "$output_dir/resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=60 "$KSS_TIMEOUT_SECONDS" \
    stata-mp -q do kss_bc/benchmarks/separations_wage_prepare.do \
    "$KSS_EXPERIMENT_ID" "$KSS_WAGE_INPUT_DTA" "$wage_sha" \
    "$KSS_SAMPLE_MODE" "$KSS_MAX_WORKERS" "$output_dir" \
    "$source_commit" "$separations_commit" "$KSS_PROCESSORS" dta_only \
    > "$output_dir/application.txt" 2>&1
  test -s "$output_dir/prepared.dta"
  test -s "$output_dir/prepare.csv"
  test -s "$output_dir/prepare.stata.pass"
  sha256sum "$output_dir/prepared.dta" | awk '{print $1}' \
    > "$output_dir/prepared.sha256"
  [[ "$(tr -d '[:space:]' < "$output_dir/prepared.sha256")" =~ ^[0-9a-f]{64}$ ]]
  grep -F "KSS_BC SEPARATIONS PREPARE PASS" "$output_dir/application.txt"
  write_wrapper_pass
  printf '%s\n' "KSS_PROD SCC PREPARE PASS: $KSS_EXPERIMENT_ID"
  exit 0
fi

if [[ "$KSS_DATASET" != synthetic ]]; then
  prepare_dir="$KSS_RUN_DIR/experiments/prepare_$KSS_DATASET"
  prepared_dta="$prepare_dir/prepared.dta"
  prepared_sha=$(tr -d '[:space:]' < "$prepare_dir/prepared.sha256")
  [[ "$prepared_sha" =~ ^[0-9a-f]{64}$ ]]
  test "$(sha256sum "$prepared_dta" | awk '{print $1}')" = "$prepared_sha"
fi

if [[ "$KSS_STAGE" == sample_compare ]]; then
  : "${KSS_MATLAB_DETAIL:?}"
  : "${KSS_MATLAB_DETAIL_SHA256:?}"
  [[ "$KSS_MATLAB_DETAIL_SHA256" =~ ^[0-9a-f]{64}$ ]]
  test "$(sha256sum "$KSS_MATLAB_DETAIL" | awk '{print $1}')" = \
    "$KSS_MATLAB_DETAIL_SHA256"
  retained_csv="$KSS_RUN_DIR/experiments/fixed_${KSS_DATASET}_cold/retained_matches.csv"
  test -s "$retained_csv"
  module purge
  module load "stata-mp/$KSS_STATA_VERSION"
  export OMP_NUM_THREADS="$KSS_PROCESSORS"
  export MKL_NUM_THREADS="$KSS_PROCESSORS"
  cd "$source_dir"
  /usr/bin/time -v -o "$output_dir/resources.txt" \
    /usr/bin/timeout --signal=TERM --kill-after=60 "$KSS_TIMEOUT_SECONDS" \
    stata-mp -q do kss_bc/benchmarks/prod_sample_compare.do \
    "$KSS_EXPERIMENT_ID" "$KSS_DATASET" "$retained_csv" \
    "$KSS_MATLAB_DETAIL" "$KSS_MATLAB_DETAIL_SHA256" "$prepared_sha" \
    "$wage_sha" "$KSS_DATA_MANIFEST_SHA256" "$KSS_BUNDLE_SHA256" \
    "$source_commit" "$KSS_PROCESSORS" "$output_dir" \
    > "$output_dir/application.txt" 2>&1
  test -s "$output_dir/sample_comparison.csv"
  test -s "$output_dir/sample_comparison.stata.pass"
  grep -F "KSS_PROD SCC SAMPLE COMPARISON PASS" "$output_dir/application.txt"
  write_wrapper_pass
  printf '%s\n' "KSS_PROD SCC SAMPLE COMPARISON WRAPPER PASS: $KSS_EXPERIMENT_ID"
  exit 0
fi

if [[ "$KSS_STAGE" == calibration_selector ]]; then
  module purge
  module load miniconda/25.3.1
  /usr/bin/time -v -o "$output_dir/resources.txt" \
    python "$source_dir/kss_bc/benchmarks/scc/select_prod_calibration.py" \
    --run-dir "$KSS_RUN_DIR" --bundle-sha "$KSS_BUNDLE_SHA256" \
    --plan "$source_dir/kss_bc/benchmarks/prod_experiments.tsv" \
    --source-commit "$source_commit" \
    --data-manifest-sha "$KSS_DATA_MANIFEST_SHA256" \
    --prepared-sha "$prepared_sha" --wage-sha "$wage_sha" \
    --output "$output_dir/calibration_selection.csv" \
    > "$output_dir/application.txt" 2>&1
  grep -F "KSS_PROD CALIBRATION SELECTOR PASS" "$output_dir/application.txt"
  write_wrapper_pass
  printf '%s\n' "KSS_PROD SCC CALIBRATION SELECTOR PASS"
  exit 0
fi

estimator_input_dta="$prepared_dta"
estimator_input_sha="$prepared_sha"
if [[ "$KSS_STAGE" == stress2x ]]; then
  full_dir="$KSS_RUN_DIR/experiments/cz18_full200"
  estimator_input_dta="$full_dir/retained_sample.dta"
  estimator_input_sha=$(tr -d '[:space:]' < "$full_dir/retained_sample.sha256")
  [[ "$estimator_input_sha" =~ ^[0-9a-f]{64}$ ]]
  test "$(sha256sum "$estimator_input_dta" | awk '{print $1}')" = \
    "$estimator_input_sha"
fi

module purge
module load "stata-mp/$KSS_STATA_VERSION"
export OMP_NUM_THREADS="$KSS_PROCESSORS"
export MKL_NUM_THREADS="$KSS_PROCESSORS"
cd "$source_dir"
/usr/bin/time -v -o "$output_dir/resources.txt" \
  /usr/bin/timeout --signal=TERM --kill-after=60 "$KSS_TIMEOUT_SECONDS" \
  stata-mp -q do kss_bc/benchmarks/scc/kss_prod_driver.do \
  "$KSS_EXPERIMENT_ID" "$KSS_STAGE" "$estimator_input_dta" "$prepared_sha" \
  "$estimator_input_sha" "$wage_sha" "$KSS_DATA_MANIFEST_SHA256" \
  "$KSS_BUNDLE_SHA256" "$KSS_PRECONDITIONER" "$KSS_BATCH" \
  "$KSS_PROBES" 8675309 "$KSS_MEMORY_GIB" "$KSS_TEMPERATURE" \
  "$KSS_REPETITIONS" "$KSS_PROCESSORS" "$source_commit" "$output_dir" \
  > "$output_dir/application.txt" 2>&1

test -s "$output_dir/prod_$KSS_EXPERIMENT_ID.csv"
test -s "$output_dir/prod_$KSS_EXPERIMENT_ID.stata.pass"
if [[ "$KSS_STAGE" == full ]]; then
  test -s "$output_dir/retained_sample.dta"
  sha256sum "$output_dir/retained_sample.dta" | awk '{print $1}' \
    > "$output_dir/retained_sample.sha256"
fi
grep -F "KSS_PROD SCC" "$output_dir/application.txt"
write_wrapper_pass
printf '%s\n' "KSS_PROD SCC STAGE PASS: $KSS_EXPERIMENT_ID"
