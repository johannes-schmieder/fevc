#!/bin/bash -l
#$ -P welfgr
#$ -cwd
#$ -j y
#$ -pe omp 4
#$ -l h_rt=00:20:00
#$ -l mem_per_core=4G
#$ -N kss_sep_cmp

set -euo pipefail
: "${KSS_RUN_DIR:?}"
: "${KSS_SOURCE_DIR:?}"
: "${KSS_SOURCE_COMMIT:?}"
: "${KSS_LABEL:?}"
test "$(tr -d '[:space:]' < "$KSS_RUN_DIR/source_commit.txt")" = "$KSS_SOURCE_COMMIT"

module purge
module load stata-mp/19
export OMP_NUM_THREADS="${NSLOTS:-4}"
job_dir="$KSS_RUN_DIR/separations/$KSS_LABEL/comparison"
mkdir -p "$job_dir"
cd "$KSS_SOURCE_DIR"
/usr/bin/time -v -o "$job_dir/resources.txt" \
  stata-mp -q do kss_bc/benchmarks/separations_compare_samples.do \
  "$KSS_LABEL" "$KSS_RUN_DIR" "$KSS_SOURCE_COMMIT" \
  > "$job_dir/application.txt" 2>&1
grep -F "KSS_BC SEPARATIONS SAMPLE COMPARISON PASS: $KSS_LABEL" \
  "$job_dir/application.txt"
printf '%s\n' "KSS_BC_SEPARATIONS_COMPARE_WRAPPER_PASS $KSS_LABEL $KSS_SOURCE_COMMIT" \
  > "$job_dir/wrapper.pass"
printf '%s\n' "KSS_BC SCC SEPARATIONS COMPARE PASS: $KSS_LABEL"
