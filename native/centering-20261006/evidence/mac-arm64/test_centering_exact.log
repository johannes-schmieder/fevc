  7.    if "`controls'"=="fixedoffset" local nuisance fixedoffset
  8.    di "CELL `deletion' `stay' `controls'"
  9.    quietly fevc y `covars' [fw=copies], worker(w) firm(f) backend(`backend
> ') algorithm(exact) deletion(`deletion') stayers(`stay') nuisance(`nuisance')
>  targetweight(mass) centering(corrected) mcse(off) nodisplay
